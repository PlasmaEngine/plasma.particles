[PLATFORMS]
ALL

[PERMUTATIONS]

RENDER_PASS
PARTICLE_RENDER_MODE
PARTICLE_QUAD_MODE
PARTICLE_LIGHTING_MODE
SHADING_QUALITY
SHADOW_QUALITY
CAMERA_MODE

[MATERIALPARAMETER]

// The default particle shader isn't used through a material, so it doesn't define material parameters.

[RENDERSTATE]

#include <Shaders/Particles/ParticleRenderState.h>

[SHADER]

#if PARTICLE_LIGHTING_MODE == PARTICLE_LIGHTING_MODE_SIX_WAY
  // the key light drives the baked directional response, the rest is summed into ambient
  #define CUSTOM_INTERPOLATOR float FogAmount : FOG; float Life : TEXCOORD1; float Variation : TEXCOORD2; float3 KeyLightDir : TEXCOORD3; float3 KeyLightColor : TEXCOORD4; float3 AmbientLight : TEXCOORD5; float Emissive : TEXCOORD6;
#elif PARTICLE_LIGHTING_MODE == PARTICLE_LIGHTING_MODE_PER_PIXEL
  // the pixel shader runs the whole clustered light loop, so it needs the surface it is shading
  #define CUSTOM_INTERPOLATOR float FogAmount : FOG; float Life : TEXCOORD1; float Variation : TEXCOORD2; float3 LitWorldPos : TEXCOORD3; float3 LitNormal : TEXCOORD4; float Emissive : TEXCOORD6;
#else
  #define CUSTOM_INTERPOLATOR float FogAmount : FOG; float Life : TEXCOORD1; float Variation : TEXCOORD2; float Emissive : TEXCOORD6;
#endif
#define USE_TEXCOORD0
#define USE_COLOR0

// the vertex shader fills Emissive, the pixel shader defines GetParticleEmissive and GetParticleDistortionOffset
#define PARTICLE_HAS_EMISSIVE
#define PARTICLE_HAS_DISTORTION_OFFSET

[VERTEXSHADER]

#include <Shaders/Particles/QuadParticleVertexShader.h>

[PIXELSHADER]

#include <Shaders/Particles/ParticlePixelShader.h>

// The default shader has to use BG_DRAW_CALL, but custom materials must use BG_MATERIAL.
Texture2D ParticleTexture BIND_GROUP(BG_DRAW_CALL);
SamplerState ParticleTexture_AutoSampler BIND_GROUP(BG_DRAW_CALL);

#if PARTICLE_RENDER_MODE == PARTICLE_RENDER_MODE_DISTORTION
  Texture2D ParticleDistortionTexture BIND_GROUP(BG_DRAW_CALL);
  SamplerState ParticleDistortionTexture_AutoSampler BIND_GROUP(BG_DRAW_CALL);
#endif

Texture2D ParticleEmissiveMap BIND_GROUP(BG_DRAW_CALL);
SamplerState ParticleEmissiveMap_AutoSampler BIND_GROUP(BG_DRAW_CALL);

#if PARTICLE_LIGHTING_MODE == PARTICLE_LIGHTING_MODE_SIX_WAY
  // Baked light response. Positive map .rgb = light from +right / +up / +front with density in
  // .a; negative map .rgb = the opposing three directions.
  Texture2D ParticleSixWayMapA BIND_GROUP(BG_DRAW_CALL);
  SamplerState ParticleSixWayMapA_AutoSampler BIND_GROUP(BG_DRAW_CALL);
  Texture2D ParticleSixWayMapB BIND_GROUP(BG_DRAW_CALL);
  SamplerState ParticleSixWayMapB_AutoSampler BIND_GROUP(BG_DRAW_CALL);
#endif

#if PARTICLE_LIGHTING_MODE == PARTICLE_LIGHTING_MODE_PER_PIXEL
  Texture2D ParticleNormalMap BIND_GROUP(BG_DRAW_CALL);
  SamplerState ParticleNormalMap_AutoSampler BIND_GROUP(BG_DRAW_CALL);
#endif

// Global values use the 'static' keyword so that they can be shared between functions
static float4 g_BaseColor = float4(1.0, 0.0, 1.0, 1.0);

/* === Available input data ===

G.Input looks like this:
struct PS_IN
{
  float4 Position : SV_Position;
  float2 TexCoord0 : TEXCOORD0;
  float4 Color0 : COLOR0;
  float FogAmount : FOG;
  float Life : TEXCOORD1;
  float Variation : TEXCOORD2;
};

Particle System constants can be accessed through the plParticleSystemConstants buffer, see
  Data/Base/Shaders/Particles/ParticleSystemConstants.h

*/

void FillCustomGlobals()
{
#if PARTICLE_RENDER_MODE == PARTICLE_RENDER_MODE_NONE
  // this code path isn't really necessary, but if someone tries to use the default shader in a material
  // this makes sure it at least shows something visible. It runs against a stand-in input struct that
  // carries none of the custom interpolators, so it has to come before the lit paths.
  g_BaseColor = float4(G.Input.TexCoord0.xy, 1.0, 1.0);

#elif PARTICLE_LIGHTING_MODE == PARTICLE_LIGHTING_MODE_SIX_WAY

  // Blend the six baked responses by where the key light sits relative to the camera. This is
  // what gives a flat card internal shadowing and a rim when lit from behind.
  float4 mapPos = ParticleSixWayMapA.Sample(ParticleSixWayMapA_AutoSampler, G.Input.TexCoord0.xy);
  float4 mapNeg = ParticleSixWayMapB.Sample(ParticleSixWayMapB_AutoSampler, G.Input.TexCoord0.xy);

  float3 weightsPos, weightsNeg;
  ComputeSixWayWeights(normalize(G.Input.KeyLightDir), weightsPos, weightsNeg);

  // Absorption: the baked maps are how much light survives the trip through the smoke, so
  // raising them to a power is a denser medium. 1 leaves the bake alone, higher darkens the
  // interior and deepens the contrast between the lit and shadowed sides.
  float3 absorbedPos = pow(saturate(mapPos.rgb), SixWayAbsorption);
  float3 absorbedNeg = pow(saturate(mapNeg.rgb), SixWayAbsorption);

  float response = dot(absorbedPos, weightsPos) + dot(absorbedNeg, weightsNeg);

  // the unlit side still receives ambient, approximated by the mean of all six responses
  float ambientResponse = dot(absorbedPos + absorbedNeg, (1.0 / 6.0).xxx);

  // The response maps already carry the smoke's own shading, so they ARE the lit colour rather
  // than a mask over some albedo, and the density rides in the positive map's alpha. The
  // self-illuminated part - fire cores and embers - comes from the emissive map on top.
  float3 lit = G.Input.KeyLightColor * response + G.Input.AmbientLight * ambientResponse;

  g_BaseColor = float4(lit, mapPos.a);

#else
  g_BaseColor = ParticleTexture.Sample(ParticleTexture_AutoSampler, G.Input.TexCoord0.xy);
#endif
}

float GetParticleOpacity()
{
  return g_BaseColor.a * G.Input.Color0.a;
}

float3 GetParticleColor()
{
  float3 particleColor = g_BaseColor.rgb;

// PARTICLE_RENDER_MODE_NONE shades against a stand-in input struct that carries none of the
// custom interpolators, so the lit path has to be compiled out for it.
#if PARTICLE_LIGHTING_MODE == PARTICLE_LIGHTING_MODE_PER_PIXEL && PARTICLE_RENDER_MODE != PARTICLE_RENDER_MODE_NONE
  // The spherical normal is interpolated across the sprite, so each pixel gets its own light and
  // shadow term instead of the four corner samples the vertex path settles for.
  float3 litNormal = normalize(G.Input.LitNormal);

  if (NormalMapStrength > 0.0)
  {
    // The tangent frame comes from screen-space derivatives rather than an interpolant, so this
    // works for every quad orientation without the vertex shader having to supply one.
    float3 dPosX = ddx(G.Input.LitWorldPos);
    float3 dPosY = ddy(G.Input.LitWorldPos);
    float2 dUvX = ddx(G.Input.TexCoord0.xy);
    float2 dUvY = ddy(G.Input.TexCoord0.xy);

    float det = dUvX.x * dUvY.y - dUvY.x * dUvX.y;

    if (abs(det) > 1e-12)
    {
      float3 tangent = normalize((dPosX * dUvY.y - dPosY * dUvX.y) / det);
      float3 bitangent = normalize(cross(litNormal, tangent));
      tangent = cross(bitangent, litNormal); // re-orthogonalise against the shading normal

      float3 tangentNormal = ParticleNormalMap.Sample(ParticleNormalMap_AutoSampler, G.Input.TexCoord0.xy).xyz * 2.0 - 1.0;
      float3 mappedNormal = normalize(tangent * tangentNormal.x + bitangent * tangentNormal.y + litNormal * tangentNormal.z);

      litNormal = normalize(lerp(litNormal, mappedNormal, NormalMapStrength));
    }
  }

  particleColor *= CalculateParticleLighting(G.Input.Position, G.Input.LitWorldPos, litNormal);
#endif

  return particleColor.rgb * G.Input.Color0.rgb;
}

// PARTICLE_RENDER_MODE_NONE shades against a stand-in input struct without these interpolators
#if PARTICLE_RENDER_MODE != PARTICLE_RENDER_MODE_NONE

float3 GetParticleEmissive()
{
  return SampleParticleEmissive(ParticleEmissiveMap, ParticleEmissiveMap_AutoSampler, G.Input.TexCoord0.xy, G.Input.Emissive);
}

float2 GetParticleDistortionOffset()
{
#  if PARTICLE_RENDER_MODE == PARTICLE_RENDER_MODE_DISTORTION
  // without a distortion texture the quad pushes the image outwards from its centre, like a lens
  float2 texDistort = (LookFlags & PARTICLE_LOOK_FLAG_DISTORTION_TEXTURE) != 0 ?ParticleDistortionTexture.Sample(ParticleDistortionTexture_AutoSampler, G.Input.TexCoord0.xy).xy : G.Input.TexCoord0.xy;
  return (texDistort - 0.5) * DistortionStrength;
#  else
  return 0.0;
#  endif
}

#endif
