[PLATFORMS]
ALL

[PERMUTATIONS]

RENDER_PASS
PARTICLE_RENDER_MODE
PARTICLE_LIGHTING_MODE
SHADOW_QUALITY
SHADING_QUALITY
CAMERA_MODE

[MATERIALPARAMETER]

// The default particle shader isn't used through a material, so it doesn't define material parameters.

[RENDERSTATE]

#include <Shaders/Particles/ParticleRenderState.h>

[SHADER]

#define CUSTOM_INTERPOLATOR float FogAmount : FOG; float Life : TEXCOORD1; float Variation : TEXCOORD2;
#define USE_TEXCOORD0
#define USE_COLOR0

[VERTEXSHADER]

#include <Shaders/Particles/RibbonParticleVertexShader.h>

[PIXELSHADER]

// ribbons have an emissive map but no per-particle emissive multiplier
#define PARTICLE_HAS_EMISSIVE

#include <Shaders/Particles/ParticlePixelShader.h>

// The default shader has to use BG_DRAW_CALL, but custom materials must use BG_MATERIAL.
Texture2D ParticleTexture BIND_GROUP(BG_DRAW_CALL);
SamplerState ParticleTexture_AutoSampler BIND_GROUP(BG_DRAW_CALL);

Texture2D ParticleEmissiveMap BIND_GROUP(BG_DRAW_CALL);
SamplerState ParticleEmissiveMap_AutoSampler BIND_GROUP(BG_DRAW_CALL);

static float4 g_BaseColor = float4(0.0, 0.0, 0.0, 0.0);

void FillCustomGlobals()
{
#if PARTICLE_RENDER_MODE == PARTICLE_RENDER_MODE_NONE
  g_BaseColor = float4(G.Input.TexCoord0.xy, 1.0, 1.0);
#else
  g_BaseColor = ParticleTexture.Sample(ParticleTexture_AutoSampler, G.Input.TexCoord0.xy);
#endif
}

float GetParticleOpacity()
{
  return g_BaseColor.a * G.Input.Color0.a;
}

float3 GetParticleColor()
{
  return g_BaseColor.rgb * G.Input.Color0.rgb;
}

float3 GetParticleEmissive()
{
#if PARTICLE_RENDER_MODE == PARTICLE_RENDER_MODE_NONE
  return 0.0;
#else
  return SampleParticleEmissive(ParticleEmissiveMap, ParticleEmissiveMap_AutoSampler, G.Input.TexCoord0.xy, 1.0);
#endif
}
