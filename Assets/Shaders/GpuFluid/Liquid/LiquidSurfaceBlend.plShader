[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidSurface.hlsli>

// Temporal blend of the surface level set: phi = (1 - b) phi_new + b advect(phi_prev), phi_prev the last frame's
// surface carried along the grid velocity (semi-Lagrangian, a back trace from the cell centre over the frame's time).
// It takes the flicker out of particles that slip from one cell into the next. Where the last frame's surface is not
// known (its brick was not extracted then) or is far air, the new value is taken as it is, so liquid that just
// arrived does not fade in.
//
// GpuFluidLiqSurfPhi is this frame's raw level set (LiquidLevelSet). GpuFluidLiqPass.x: tag of this extraction;
// GpuFluidLiqPassF: x outside value, y far value, z blend b, w frame time / dx (cells per m/s).

RWByteAddressBuffer GpuFluidLiqPhiOut;
ByteAddressBuffer GpuFluidLiqPhiPrev;
ByteAddressBuffer GpuFluidLiqStampPrev;
RWByteAddressBuffer GpuFluidLiqStampOut;
ByteAddressBuffer GpuFluidLiqVel;

float CellVelocity(int3 c, uint comp)
{
  const int3 axis = LiqAxis(comp);
  return 0.5 * (asfloat(GpuFluidLiqVel.Load(LiqFaceAddress(comp, c))) + asfloat(GpuFluidLiqVel.Load(LiqFaceAddress(comp, c + axis))));
}

/// Last frame's surface at sample s, or false where it is not known.
bool PrevPhi(int3 s, uint prevTag, out float out_phi)
{
  out_phi = SurfFarValue();
  if (!LiqInside(s))
  {
    out_phi = SurfOutsideValue();
    return true;
  }
  if (GpuFluidLiqStampPrev.Load(LiqBrickIndex(s) * 4) != prevTag)
    return false;
  out_phi = asfloat(GpuFluidLiqPhiPrev.Load(LiqCellIndex(s) * 4));
  return true;
}

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES
  int3 cell;
  if (!LiqBrickCell(groupId, groupThreadId, cell))
    return;

  const uint tag = LIQ_CONST(GpuFluidLiqPass).x;
  const float4 params = LIQ_CONST(GpuFluidLiqPassF);
  const uint index = LiqCellIndex(cell);
  const float phiNew = asfloat(GpuFluidLiqSurfPhi.Load(index * 4));
  float phi = phiNew;

  if (groupIndex == 0)
    GpuFluidLiqStampOut.Store(LiqBrickIndex(cell) * 4, tag);

  if (params.z > 0.0)
  {
    // Back trace, at most two cells.
    float3 v = float3(CellVelocity(cell, 0), CellVelocity(cell, 1), CellVelocity(cell, 2));
    v = LiqIsFinite3(v) ? v : float3(0, 0, 0);
    float3 step = v * params.w;
    const float len = length(step);
    if (len > 2.0)
      step *= 2.0 / len;

    // Trilinear between the 8 cell centres around the back-traced point (cell units, centres at index + 0.5).
    const float3 p = float3(cell) + 0.5 - step - 0.5;
    const int3 base = int3(floor(p));
    const float3 f = p - float3(base);

    bool bKnown = true;
    float corners[8];
    [unroll] for (uint i = 0; i < 8; ++i)
    {
      const int3 o = int3(i & 1, (i >> 1) & 1, (i >> 2) & 1);
      bKnown = PrevPhi(base + o, tag - 1, corners[i]) && bKnown;
    }

    if (bKnown)
    {
      const float x00 = lerp(corners[0], corners[1], f.x);
      const float x10 = lerp(corners[2], corners[3], f.x);
      const float x01 = lerp(corners[4], corners[5], f.x);
      const float x11 = lerp(corners[6], corners[7], f.x);
      const float prev = lerp(lerp(x00, x10, f.y), lerp(x01, x11, f.y), f.z);
      if (prev < 0.99 * SurfFarValue())
        phi = lerp(phiNew, prev, params.z);
    }
  }

  GpuFluidLiqPhiOut.Store(index * 4, asuint(phi));
}
