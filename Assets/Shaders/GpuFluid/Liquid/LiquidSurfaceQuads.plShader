[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidSurface.hlsli>

// Surface nets, quads: every edge between two samples that crosses the surface gets one quad joining the vertices of
// the four cubes around it, wound counter-clockwise seen from outside the liquid. The thread of cell c handles the
// edges from sample c along +x, +y and +z, and on the domain's low sides also the edge from the sample outside.
//
// Quad: four vertex indices. GpuFluidLiqPass.y: quad capacity. GpuFluidLiqPassF: x outside value, y far value.

RWByteAddressBuffer GpuFluidLiqSurfCubeMap;
RWByteAddressBuffer GpuFluidLiqSurfQuads;
RWByteAddressBuffer GpuFluidLiqSurfCounters;

uint CubeVertex(int3 m)
{
  return SurfCubeExists(m) ? GpuFluidLiqSurfCubeMap.Load(SurfCubeIndex(m) * 4) : GPU_FLUID_LIQUID_SURFACE_NO_VERTEX;
}

// The surface level set of the brick and one sample around it, worked out once per sample (see LiquidSurfaceVerts).
#define SURF_TILE (GPU_FLUID_LIQUID_BRICK + 2)
#define SURF_TILE_SAMPLES (SURF_TILE * SURF_TILE * SURF_TILE)
groupshared float gs_fPhi[SURF_TILE_SAMPLES];
static int3 s_TileOrigin;

float TilePhi(int3 s)
{
  const int3 l = s - s_TileOrigin + 1;
  return gs_fPhi[l.x + SURF_TILE * (l.y + SURF_TILE * l.z)];
}

void ProcessEdge(int3 e, uint a, uint capacity)
{
  const int3 axisA = LiqAxis(a);
  const float phiLow = TilePhi(e);
  const float phiHigh = TilePhi(e + axisA);
  const bool bLowInside = phiLow < 0.0;
  if (bLowInside == (phiHigh < 0.0))
    return;

  // The other two axes in cyclic order, so (a, b, c) is right handed and the cubes below go counter-clockwise around +a.
  const int3 axisB = LiqAxis((a + 1) % 3);
  const int3 axisC = LiqAxis((a + 2) % 3);
  uint4 quad = uint4(CubeVertex(e - axisB - axisC), CubeVertex(e - axisC), CubeVertex(e), CubeVertex(e - axisB));
  if (any(quad == GPU_FLUID_LIQUID_SURFACE_NO_VERTEX))
    return;

  // Liquid on the low side: the outside is towards +a, which the order above faces. Otherwise reverse it.
  if (!bLowInside)
    quad = quad.xwzy;

  uint slot;
  GpuFluidLiqSurfCounters.InterlockedAdd(GPU_FLUID_LIQUID_SURFACE_CTR_QUADS * 4, 1u, slot);
  if (slot >= capacity)
  {
    GpuFluidLiqSurfCounters.InterlockedAdd(GPU_FLUID_LIQUID_SURFACE_CTR_QUAD_OVERFLOW * 4, 1u);
    return;
  }
  GpuFluidLiqSurfQuads.Store4(slot * GPU_FLUID_LIQUID_SURFACE_QUAD_BYTES, quad);
}

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES
  // The whole group takes the same branch: past the end of the brick list it leaves before the barrier.
  const uint4 args = GpuFluidLiqBrickArgs.Load4(0);
  const uint listIndex = GpuFluidLinearGroup(groupId, args.x);
  if (listIndex >= args.w)
    return;
  const uint brick = GpuFluidLiqBrickList.Load(listIndex * 4);
  const uint3 bricks = LiqBricks();
  s_TileOrigin = int3(uint3(brick % bricks.x, (brick / bricks.x) % bricks.y, brick / (bricks.x * bricks.y)) * GPU_FLUID_LIQUID_BRICK);
  for (uint t = groupIndex; t < SURF_TILE_SAMPLES; t += GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK)
    gs_fPhi[t] = SurfPhi(s_TileOrigin + int3(t % SURF_TILE, (t / SURF_TILE) % SURF_TILE, t / (SURF_TILE * SURF_TILE)) - 1);
  GroupMemoryBarrierWithGroupSync();

  const int3 cell = s_TileOrigin + int3(groupThreadId);
  if (!LiqInside(cell))
    return;

  const uint capacity = LIQ_CONST(GpuFluidLiqPass).y;

  [loop] for (uint a = 0; a < 3; ++a)
  {
    ProcessEdge(cell, a, capacity);
    const int3 axis = LiqAxis(a);
    if (dot(cell, axis) == 0)
      ProcessEdge(cell - axis, a, capacity);
  }
}
