[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#define GPU_FLUID_LIQUID_BRICK_DISPATCH
#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidCells.hlsli>

// Right-hand side of the pressure solve. The unknown is phi = p * dt / (rho * dx) (m/s), so a face's projection is
// u -= phi(i) - phi(i - 1) and the equation of a liquid cell is sum over its open faces of (phi_i - phi_nb) =
// dx * D_target - F, with F the cell's net outflux (m/s) and D_target the divergence the solve aims for:
// - local density correction k * e, k in 1/s (at most 0.5 / dt), e = rho / rho0 - 1 the density error of the cell.
//   rho is a smooth particle density: the quadratic B-spline kernel at the cell centre, summed over the particles of
//   the liquid cells of the 3x3x3 block around it and normalised by the kernel mass of those cells (so walls, solids
//   and air around do not read as missing particles). A smooth measure, unlike a particle count, changes little when
//   a particle crosses a face, so a pool the correction has evened out stays at rest.
//   Two-sided (dense cells push out, sparse ones pull in) in deep cells, whose 3x3x3 block holds no air and no solid;
//   one-sided (only crowding is corrected) near the free surface, where a cell is only partly liquid and reads sparse,
//   and beside solids, whose faces cut cells (P8: two-sided there packed the settled pour 2% tighter). The equilibrium
//   is e = 0 in the deep liquid whatever dt and the substep count, so the rest packing does not follow them.
// - global volume control c * (V_target - V) / V_target with c in 1/s, V_target = (seeded - drained) / n0
//   cells, V the measure of LiquidClassify. The relative error is clamped to +-25%.
// Also rescales the warm start by the dt ratio (exact for the hydrostatic part of phi) and zeroes phi outside the
// liquid.
//
// GpuFluidLiqPassF: x dead zone on |e| (0: none), y > 0 two-sided in deep cells, z the largest |e| corrected.

ByteAddressBuffer GpuFluidLiqCellCount;
ByteAddressBuffer GpuFluidLiqCellStart;
ByteAddressBuffer GpuFluidLiqPositions;
RWByteAddressBuffer GpuFluidLiqCellType;
RWByteAddressBuffer GpuFluidLiqVel;
RWByteAddressBuffer GpuFluidLiqPressure;
RWByteAddressBuffer GpuFluidLiqRhs;
RWByteAddressBuffer GpuFluidLiqCounters;

/// Quadratic B-spline at offset t (cells).
float BSpline2(float t)
{
  const float a = abs(t);
  return a < 0.5 ? 0.75 - a * a : (a < 1.5 ? 0.5 * (1.5 - a) * (1.5 - a) : 0.0);
}

#define LIQ_HALO (GPU_FLUID_LIQUID_BRICK + 2)
#define LIQ_HALO_CELLS (LIQ_HALO * LIQ_HALO * LIQ_HALO)
#define LIQ_THREADS (GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK)
#define LIQ_DENSITY_SCALE 1048576.0 // fixed point of the density sums: a cell overflows past about 2048 (n0 is 8)
#define LIQ_DENSITY_MAX_PER_CELL 256

// The density by scatter: one thread per liquid cell of the brick and of the one-cell halo around it reads its particles
// once and adds their kernel weights to the cells of the brick they reach (integer sums, so the order does not
// matter). Gathering it per cell read every particle 27 times; a scatter per particle took 27 atomics per particle.
groupshared int gs_iDensity[LIQ_THREADS];

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES

  // The whole group takes the same branch: past the end of the brick list it leaves before the barrier.
  const uint4 args = GpuFluidLiqBrickArgs.Load4(0);
  const uint listIndex = GpuFluidLinearGroup(groupId, args.x);
  if (listIndex >= args.w)
    return;
  const uint brick = GpuFluidLiqBrickList.Load(listIndex * 4);
  const uint3 bricks = LiqBricks();
  const int3 origin = int3(uint3(brick % bricks.x, (brick / bricks.x) % bricks.y, brick / (bricks.x * bricks.y)) * GPU_FLUID_LIQUID_BRICK);
  const uint3 cells = LiqCells();
  const float invDx = LiqInvDx();

  gs_iDensity[groupIndex] = 0;
  GroupMemoryBarrierWithGroupSync();

  for (uint h = groupIndex; h < LIQ_HALO_CELLS; h += LIQ_THREADS)
  {
    const int3 source = origin + int3(h % LIQ_HALO, (h / LIQ_HALO) % LIQ_HALO, h / (LIQ_HALO * LIQ_HALO)) - 1;
    if (LiqTypeAt(GpuFluidLiqCellType, source, cells, true) != GPU_FLUID_LIQUID_CELL_LIQUID)
      continue;
    const uint sourceIndex = LiqCellIndex(source);
    const uint count = min(GpuFluidLiqCellCount.Load(sourceIndex * 4), (uint)LIQ_DENSITY_MAX_PER_CELL);
    const uint start = GpuFluidLiqCellStart.Load(sourceIndex * 4);
    if (count == 0)
      continue;

    // The cell's kernel weight at the 27 cell centres around it, summed over its particles in registers, then one
    // atomic per target inside the brick.
    float sums[27];
    [unroll] for (uint o = 0; o < 27; ++o)
      sums[o] = 0.0;
    for (uint k = 0; k < count; ++k)
    {
      const float3 d = asfloat(GpuFluidLiqPositions.Load3((start + k) * GPU_FLUID_LIQUID_POSITION_BYTES)) * invDx - (float3(source) + 0.5);
      float3 w[3];
      [unroll] for (uint j = 0; j < 3; ++j)
        w[j] = float3(BSpline2(d.x - float(j) + 1.0), BSpline2(d.y - float(j) + 1.0), BSpline2(d.z - float(j) + 1.0));
      [unroll] for (uint o = 0; o < 27; ++o)
        sums[o] += w[o % 3].x * w[(o / 3) % 3].y * w[o / 9].z;
    }
    [unroll] for (uint o = 0; o < 27; ++o)
    {
      const int3 local = source + int3(o % 3, (o / 3) % 3, o / 9) - 1 - origin;
      if (all(local >= 0) && all(local < GPU_FLUID_LIQUID_BRICK) && sums[o] > 0.0)
        InterlockedAdd(gs_iDensity[local.x + GPU_FLUID_LIQUID_BRICK * (local.y + GPU_FLUID_LIQUID_BRICK * local.z)], (int)round(sums[o] * LIQ_DENSITY_SCALE));
    }
  }
  GroupMemoryBarrierWithGroupSync();

  const int3 cell = origin + int3(groupThreadId);
  if (!LiqInside(cell))
    return;

  const uint index = LiqCellIndex(cell);
  if ((GpuFluidLiqCellType.Load(index * 4) & 3u) != GPU_FLUID_LIQUID_CELL_LIQUID)
  {
    GpuFluidLiqPressure.Store(index * 4, 0u);
    GpuFluidLiqRhs.Store(index * 4, 0u);
    return;
  }

  float outflux = 0.0;
  [unroll] for (uint comp = 0; comp < 3; ++comp)
  {
    const int3 axis = LiqAxis(comp);
    outflux += asfloat(GpuFluidLiqVel.Load(LiqFaceAddress(comp, cell + axis))) - asfloat(GpuFluidLiqVel.Load(LiqFaceAddress(comp, cell)));
  }

  const float4 solve = LIQ_CONST(GpuFluidLiqSolve);
  const float4 params = LIQ_CONST(GpuFluidLiqPassF);
  const float dt = max(LiqDt(), 1e-6);
  const float n0 = LiqParticlesPerCell();

  // Kernel mass of a cell at offset o from the centre, per axis: 2/3 for the cell itself, 1/6 for each side.
  const float density = float(gs_iDensity[groupIndex]) / LIQ_DENSITY_SCALE;
  float mass = 0.0;
  bool bDeep = true;
  for (int z = -1; z <= 1; ++z)
  {
    for (int y = -1; y <= 1; ++y)
    {
      for (int x = -1; x <= 1; ++x)
      {
        const int3 o = int3(x, y, z);
        const int3 nb = cell + o;
        const uint t = LiqTypeAt(GpuFluidLiqCellType, nb, cells, true);
        // Beside a solid the cells are only partly free for particles (a solid's face does not lie on a cell face), and
        // read sparse at the right packing: the sparse side is not corrected there either.
        if (t == GPU_FLUID_LIQUID_CELL_AIR || t == GPU_FLUID_LIQUID_CELL_SOLID)
          bDeep = false;
        if (t == GPU_FLUID_LIQUID_CELL_OUTSIDE)
        {
          // An open side is air beyond the domain; a wall is solid.
          [unroll] for (uint a = 0; a < 3; ++a)
          {
            if (o[a] != 0 && (nb[a] < 0 || nb[a] >= (int)cells[a]) && LiqNeighbourSideOpen(a * 2 + (o[a] > 0 ? 1u : 0u)))
              bDeep = false;
          }
        }
        if (t != GPU_FLUID_LIQUID_CELL_LIQUID)
          continue;

        const float3 share = float3(abs(o.x) == 0 ? 2.0 / 3.0 : 1.0 / 6.0, abs(o.y) == 0 ? 2.0 / 3.0 : 1.0 / 6.0, abs(o.z) == 0 ? 2.0 / 3.0 : 1.0 / 6.0);
        mass += share.x * share.y * share.z;
      }
    }
  }

  // A cell whose 3x3x3 block holds a surface cell (one with air beside it) reads sparse too: the kernel reaches into
  // that cell, which is only part full, while its mass counts it whole. Under a 3/4-full top layer that read the layer
  // below 2-3% sparse, and the two-sided correction drew a steady flow through the whole pool (P8, the random-seed
  // tank at 16.75 cells). The surface lies above or beside, so the cells two away along each axis are checked as well.
  if (bDeep)
  {
    [unroll] for (uint n = 0; n < 6; ++n)
    {
      const int3 o = 2 * LiqNeighbourOffset(n);
      const uint t = LiqTypeAt(GpuFluidLiqCellType, cell + o, cells, true);
      if (t == GPU_FLUID_LIQUID_CELL_AIR || (t == GPU_FLUID_LIQUID_CELL_OUTSIDE && LiqNeighbourSideOpen(n)))
        bDeep = false;
    }
  }

  // Density error. GpuFluidLiqPassF.x: a dead zone on |e| (0 by default); z: the largest |e| a step corrects.
  const float rho = density / max(mass * n0, 1e-6);
  float e = rho - 1.0;
  const float deadZone = max(params.x, 0.0);
  e = sign(e) * max(abs(e) - deadZone, 0.0);
  const bool bTwoSided = params.y > 0.0 && bDeep;
  e = clamp(e, bTwoSided ? -params.z : 0.0, params.z);
  float target = min(solve.y, 0.5 / dt) * e;

  const float seeded = float(GpuFluidLiqCounters.Load(GPU_FLUID_LIQUID_CTR_SEEDED * 4));
  const float drained = float(GpuFluidLiqCounters.Load(GPU_FLUID_LIQUID_CTR_DRAINED * 4));
  const float targetVolume = (seeded - drained) / n0;
  const float volume = float(GpuFluidLiqCounters.Load(GPU_FLUID_LIQUID_CTR_VOLUME * 4)) / GPU_FLUID_LIQUID_VOLUME_SCALE;
  if (targetVolume > 0.0)
    target += solve.z * clamp((targetVolume - volume) / targetVolume, -0.25, 0.25);

  const float rhs = LiqDx() * target - outflux;
  GpuFluidLiqRhs.Store(index * 4, asuint(rhs));

  const float warm = asfloat(GpuFluidLiqPressure.Load(index * 4)) * solve.w;
  GpuFluidLiqPressure.Store(index * 4, asuint(LiqIsFinite3(float3(warm, 0, 0)) ? warm : 0.0));

  GpuFluidLiqCounters.InterlockedMax(GPU_FLUID_LIQUID_CTR_RHS_MAX * 4, asuint(abs(rhs)));
}
