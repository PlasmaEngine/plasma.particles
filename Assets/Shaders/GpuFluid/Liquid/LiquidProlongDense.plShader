[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidMultigrid.hlsli>

// Prolongation of the correction of level l + 1 onto coarse level l = GpuFluidLiqPass.x: piecewise constant, liquid
// cells only.

RWByteAddressBuffer GpuFluidLiqMgCoarseX;

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_LEVEL_GROUP, GPU_FLUID_LIQUID_LEVEL_GROUP, GPU_FLUID_LIQUID_LEVEL_GROUP)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  GPU_FLUID_KERNEL_MODES
  const uint level = MgLevel();
  const uint3 dims = LiqLevelDims(level);
  int3 cell;
  if (!MgRegionCell(level, dispatchThreadId, cell) || !LiqInsideDims(cell, dims))
    return;

  const uint index = LiqCellIndexIn(cell, dims);
  if (MgTypeAt(GpuFluidLiqMgType, cell, dims, level) != GPU_FLUID_LIQUID_CELL_LIQUID)
    return;

  const float correction = asfloat(GpuFluidLiqMgCoarseX.Load(LiqCellIndexIn(cell / 2, LiqLevelDims(level + 1)) * 4));
  GpuFluidLiqMgX.Store(index * 4, asuint(asfloat(GpuFluidLiqMgX.Load(index * 4)) + correction));
}
