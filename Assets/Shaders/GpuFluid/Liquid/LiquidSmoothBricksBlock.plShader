[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidPcg.hlsli>

// Every sweep of one smoothing call on the fine level in one launch: per active brick, the brick and a one-cell halo of
// the solution in groupshared memory, red-black Gauss-Seidel inside the brick with the halo held at its value from the
// start of the launch (block Gauss-Seidel: Gauss-Seidel within a brick, Jacobi between bricks, as the gas multigrid
// smooths). LiquidSmoothBricks needs one launch and one barrier per colour and sweep; on small domains those fixed
// costs, not the cells, were most of the solve.
//
// GpuFluidLiqPass: y 1 runs black before red in every sweep (the post-smoothing, so a V-cycle stays symmetric for the
// MGPCG preconditioner), z the sweeps, w flags:
// - bit 0 adds the level-1 correction (GpuFluidLiqMgCoarseX) first: LiquidProlongBricks folded into the load, the same
//   piecewise-constant correction on the same liquid cells, the halo's included, one launch fewer;
// - bit 1 writes every cell of the brick to GpuFluidLiqMgXOut, not only the smoothed ones;
// - bit 2 stores the brick's MGPCG partial of r * z (x is z, b is r here): LiquidPcgDot folded into the last launch of
//   the preconditioner's V-cycle, the same products summed in the same order;
// - bit 3 starts from z = 0 after the MGPCG step x += alpha p, r -= alpha q (GpuFluidLiqPcgX, GpuFluidLiqPcgP,
//   GpuFluidLiqPcgQ), which it makes for its own cell first: LiquidPcgUpdateX folded into the first launch of the
//   V-cycle (bit 1 too, so every z of the brick is written, as UpdateX zeroed them).
// The result goes to GpuFluidLiqMgXOut. When that is GpuFluidLiqMgX, a group can read a halo cell that the next brick
// has already written; with the correction added on load that cell would get it twice, so a launch with bit 0 writes
// to another buffer (and bit 1 keeps every cell of it defined), and the next launch copies back.

RWByteAddressBuffer GpuFluidLiqMgCoarseX;
RWByteAddressBuffer GpuFluidLiqMgXOut;
RWByteAddressBuffer GpuFluidLiqPcgX;
RWByteAddressBuffer GpuFluidLiqPcgP;
RWByteAddressBuffer GpuFluidLiqPcgQ;

#define GPU_FLUID_LIQUID_TILE (GPU_FLUID_LIQUID_BRICK + 2)
#define GPU_FLUID_LIQUID_TILE_CELLS (GPU_FLUID_LIQUID_TILE * GPU_FLUID_LIQUID_TILE * GPU_FLUID_LIQUID_TILE)

groupshared float gs_fX[GPU_FLUID_LIQUID_TILE_CELLS];

uint TileIndex(int3 local)
{
  const uint3 t = uint3(local + 1);
  return t.x + GPU_FLUID_LIQUID_TILE * (t.y + GPU_FLUID_LIQUID_TILE * t.z);
}

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES

  // The whole group takes the same branch here: past the end of the brick list it leaves before any barrier.
  const uint4 args = GpuFluidLiqBrickArgs.Load4(0);
  const uint listIndex = GpuFluidLinearGroup(groupId, args.x);
  if (listIndex >= args.w)
    return;

  const uint brick = GpuFluidLiqBrickList.Load(listIndex * 4);
  const uint3 bricks = LiqBricks();
  const int3 origin = int3(uint3(brick % bricks.x, (brick / bricks.x) % bricks.y, brick / (bricks.x * bricks.y)) * GPU_FLUID_LIQUID_BRICK);
  const uint3 dims = LiqCells();
  const bool bProlong = (LIQ_CONST(GpuFluidLiqPass).w & 1u) != 0;
  const bool bWriteAll = (LIQ_CONST(GpuFluidLiqPass).w & 2u) != 0;
  const bool bDot = (LIQ_CONST(GpuFluidLiqPass).w & 4u) != 0;
  const bool bUpdateX = (LIQ_CONST(GpuFluidLiqPass).w & 8u) != 0;
  const uint3 coarseDims = LiqLevelDims(1);

  for (uint i = groupIndex; i < GPU_FLUID_LIQUID_TILE_CELLS; i += GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK)
  {
    const int3 local = int3(i % GPU_FLUID_LIQUID_TILE, (i / GPU_FLUID_LIQUID_TILE) % GPU_FLUID_LIQUID_TILE, i / (GPU_FLUID_LIQUID_TILE * GPU_FLUID_LIQUID_TILE)) - 1;
    const int3 c = origin + local;
    float x = 0.0;
    if (LiqInside(c) && !bUpdateX)
    {
      x = asfloat(GpuFluidLiqMgX.Load(LiqCellIndex(c) * 4));
      if (bProlong && MgTypeAt(GpuFluidLiqMgType, c, dims, 0) == GPU_FLUID_LIQUID_CELL_LIQUID)
        x += asfloat(GpuFluidLiqMgCoarseX.Load(LiqCellIndexIn(c / 2, coarseDims) * 4));
    }
    gs_fX[i] = x;
  }

  // This cell's stencil, fixed for the launch: the diagonal, which neighbours are liquid, and b.
  const int3 local = int3(groupThreadId);
  const int3 cell = origin + local;
  bool bLiquid = false;
  float diag = 0.0;
  uint liquidMask = 0;
  float b = 0.0;
  bool bOwnLiquid = false;
  if (LiqInside(cell))
  {
    const uint index = LiqCellIndex(cell);
    const uint ownWord = GpuFluidLiqMgType.Load(index * 4);
    if ((ownWord & 3u) == GPU_FLUID_LIQUID_CELL_LIQUID)
    {
      bOwnLiquid = true;
      [unroll] for (uint n = 0; n < 6; ++n)
      {
        const uint t = LiqTypeAt(GpuFluidLiqMgType, cell + LiqNeighbourOffset(n), dims, true);
        const float air = LiqAirInvTheta(ownWord, n);
        if (t == GPU_FLUID_LIQUID_CELL_OUTSIDE)
        {
          if (LiqNeighbourSideOpen(n))
            diag += air;
        }
        else if (t == GPU_FLUID_LIQUID_CELL_LIQUID)
        {
          diag += 1.0;
          liquidMask |= 1u << n;
        }
        else if (t == GPU_FLUID_LIQUID_CELL_AIR)
        {
          diag += air;
        }
      }
      bLiquid = diag > 0.0;
      b = asfloat(GpuFluidLiqMgB.Load(index * 4));
      if (bUpdateX)
      {
        const float alpha = PcgScalar(GPU_FLUID_LIQUID_PCG_ALPHA);
        const float x = asfloat(GpuFluidLiqPcgX.Load(index * 4)) + alpha * asfloat(GpuFluidLiqPcgP.Load(index * 4));
        b = b - alpha * asfloat(GpuFluidLiqPcgQ.Load(index * 4));
        GpuFluidLiqPcgX.Store(index * 4, asuint(x));
        GpuFluidLiqMgB.Store(index * 4, asuint(b));
      }
    }
  }
  GroupMemoryBarrierWithGroupSync();

  const uint own = TileIndex(local);
  const uint parity = ((uint)(cell.x + cell.y + cell.z)) & 1u;
  const bool bReverse = LIQ_CONST(GpuFluidLiqPass).y != 0;
  const uint sweeps = LIQ_CONST(GpuFluidLiqPass).z;
  const float omega = MgOmega();
  for (uint sweep = 0; sweep < sweeps; ++sweep)
  {
    for (uint step = 0; step < 2; ++step)
    {
      const uint colour = bReverse ? 1u - step : step;
      if (bLiquid && parity == colour)
      {
        float sum = 0.0;
        [unroll] for (uint n = 0; n < 6; ++n)
        {
          if ((liquidMask & (1u << n)) != 0)
            sum += gs_fX[TileIndex(local + LiqNeighbourOffset(n))];
        }
        gs_fX[own] = lerp(gs_fX[own], (b + sum) / diag, omega);
      }
      GroupMemoryBarrierWithGroupSync();
    }
  }

  if (bLiquid || (bWriteAll && LiqInside(cell)))
    GpuFluidLiqMgXOut.Store(LiqCellIndex(cell) * 4, asuint(gs_fX[own]));

  // The group takes this branch as a whole (a launch constant).
  if (bDot)
    PcgStorePartial(groupIndex, LiqInside(cell), cell, bOwnLiquid ? b * gs_fX[own] : 0.0);
}
