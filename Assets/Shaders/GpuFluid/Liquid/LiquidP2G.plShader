[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#define GPU_FLUID_LIQUID_BRICK_DISPATCH
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidCommon.hlsli>

// P2G as a gather: the thread of a cell owns that cell's low u, v and w faces (and the high ones on the domain's
// last layer). It loops over the particles of the 3x3x3 cells around it, which cover every particle within one cell
// of its faces (the linear kernel's support is 2 cells along the face normal and 2 x 2 across, which reaches into
// three cells per tangential axis), and sums APIC momentum and weight in int32 registers. No atomics and no
// groupshared memory: the sums are integers, so the result does not depend on particle order.
//
// The normalised velocity goes to GpuFluidLiqVelOut, the faces with any weight are marked valid.

ByteAddressBuffer GpuFluidLiqCellCount;
ByteAddressBuffer GpuFluidLiqCellStart;
ByteAddressBuffer GpuFluidLiqPositions;
ByteAddressBuffer GpuFluidLiqVelocities;
ByteAddressBuffer GpuFluidLiqAffine;
RWByteAddressBuffer GpuFluidLiqVelOut;
RWByteAddressBuffer GpuFluidLiqValidOut;
RWByteAddressBuffer GpuFluidLiqCounters;

#define LIQ_P2G_SLOTS 6

/// Adds b to a with saturation; true when it saturated.
bool AddClamped(inout int a, int b)
{
  const int maxValue = 0x7FFFFFFF;
  if (b > 0 && a > maxValue - b)
  {
    a = maxValue;
    return true;
  }
  if (b < 0 && a < -maxValue - b)
  {
    a = -maxValue;
    return true;
  }
  a += b;
  return false;
}

[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
  int3 cell;
  if (!LiqBrickCell(groupId, groupThreadId, cell))
    return;

  const float dx = LiqDx();
  const float invDx = LiqInvDx();

  bool owned[LIQ_P2G_SLOTS];
  uint comps[LIQ_P2G_SLOTS];
  int3 faces[LIQ_P2G_SLOTS];
  float3 facePos[LIQ_P2G_SLOTS];
  int momentum[LIQ_P2G_SLOTS];
  int weight[LIQ_P2G_SLOTS];

  [unroll] for (uint s = 0; s < LIQ_P2G_SLOTS; ++s)
  {
    owned[s] = LiqOwnedFace(cell, s, comps[s], faces[s]);
    facePos[s] = LiqFacePosition(comps[s], faces[s]);
    momentum[s] = 0;
    weight[s] = 0;
  }

  uint overflow = 0;

  for (int z = -1; z <= 1; ++z)
  {
    for (int y = -1; y <= 1; ++y)
    {
      for (int x = -1; x <= 1; ++x)
      {
        const int3 nb = cell + int3(x, y, z);
        if (!LiqInside(nb))
          continue;

        const uint nbIndex = LiqCellIndex(nb);
        const uint count = GpuFluidLiqCellCount.Load(nbIndex * 4);
        const uint start = GpuFluidLiqCellStart.Load(nbIndex * 4);

        for (uint k = 0; k < count; ++k)
        {
          const uint p = start + k;
          const float3 gp = asfloat(GpuFluidLiqPositions.Load3(p * GPU_FLUID_LIQUID_POSITION_BYTES)) * invDx;
          const float3 v = asfloat(GpuFluidLiqVelocities.Load3(p * GPU_FLUID_LIQUID_VELOCITY_BYTES));

          float3 c[3];
          LiqUnpackAffine(GpuFluidLiqAffine.Load4(p * GPU_FLUID_LIQUID_AFFINE_BYTES), GpuFluidLiqAffine.Load(p * GPU_FLUID_LIQUID_AFFINE_BYTES + 16), c[0], c[1], c[2]);

          [unroll] for (uint s2 = 0; s2 < LIQ_P2G_SLOTS; ++s2)
          {
            if (!owned[s2])
              continue;

            const float3 d = facePos[s2] - gp;
            const float3 a = abs(d);
            if (any(a >= 1.0))
              continue;

            const float w = (1.0 - a.x) * (1.0 - a.y) * (1.0 - a.z);
            const uint comp = comps[s2];
            const float vc = comp == 0 ? v.x : (comp == 1 ? v.y : v.z);
            const float affine = clamp(dot(c[comp], d * dx), -GPU_FLUID_LIQUID_MAX_AFFINE, GPU_FLUID_LIQUID_MAX_AFFINE);
            const float value = clamp(vc + affine, -GPU_FLUID_LIQUID_MAX_SPEED, GPU_FLUID_LIQUID_MAX_SPEED);

            const int wi = (int)round(w * GPU_FLUID_LIQUID_WEIGHT_SCALE);
            const int mi = (int)round(w * value * GPU_FLUID_LIQUID_MOMENTUM_SCALE);
            overflow += AddClamped(weight[s2], wi) ? 1u : 0u;
            overflow += AddClamped(momentum[s2], mi) ? 1u : 0u;
          }
        }
      }
    }
  }

  uint lowValid = 0;
  [unroll] for (uint s3 = 0; s3 < LIQ_P2G_SLOTS; ++s3)
  {
    if (!owned[s3])
      continue;

    const bool bValid = weight[s3] > 0;
    const float velocity = bValid ? (float(momentum[s3]) / GPU_FLUID_LIQUID_MOMENTUM_SCALE) / (float(weight[s3]) / GPU_FLUID_LIQUID_WEIGHT_SCALE) : 0.0;
    GpuFluidLiqVelOut.Store(LiqFaceAddress(comps[s3], faces[s3]), asuint(velocity));

    const uint bit = bValid ? (1u << comps[s3]) : 0u;
    if (s3 < 3)
      lowValid |= bit;
    else
      GpuFluidLiqValidOut.Store(LiqFaceIndex(faces[s3]) * 4, bit);
  }
  GpuFluidLiqValidOut.Store(LiqFaceIndex(cell) * 4, lowValid);

  if (overflow > 0)
    GpuFluidLiqCounters.InterlockedAdd(GPU_FLUID_LIQUID_CTR_OVERFLOW * 4, overflow);
}
