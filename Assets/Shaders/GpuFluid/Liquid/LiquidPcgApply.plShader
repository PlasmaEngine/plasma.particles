[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidPcg.hlsli>

// q = A p at the liquid cells of the active bricks (p bound as GpuFluidLiqMgX, the multigrid's fine stencil), and per
// brick the sum of p * q into the brick's partial.
//
// GpuFluidLiqPass.w 1: first the new direction p = z + beta p (LiquidPcgUpdateP folded in): GpuFluidLiqMgX holds the
// old p, each p this needs (its cell's and its liquid neighbours') is made from it as UpdateP makes it, and the cell's
// is stored to GpuFluidLiqPcgPOut, another buffer, so no group reads a p that another has already replaced.

RWByteAddressBuffer GpuFluidLiqPcgQ;
RWByteAddressBuffer GpuFluidLiqPcgZ;
RWByteAddressBuffer GpuFluidLiqPcgPOut;

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES
  int3 cell;
  const bool bCell = LiqBrickCell(groupId, groupThreadId, cell);
  const bool bUpdateP = LIQ_CONST(GpuFluidLiqPass).w != 0;
  const float beta = bUpdateP ? PcgScalar(GPU_FLUID_LIQUID_PCG_BETA) : 0.0;
  float value = 0.0;
  if (bCell && PcgIsLiquid(cell))
  {
    const uint3 dims = LiqCells();
    const uint index = LiqCellIndex(cell);
    float diag, sum;
    float p;
    if (bUpdateP)
    {
      // MgStencil with the new p of the liquid neighbours.
      const uint ownWord = GpuFluidLiqMgType.Load(index * 4);
      diag = 0.0;
      sum = 0.0;
      [unroll] for (uint n = 0; n < 6; ++n)
      {
        const int3 nb = cell + LiqNeighbourOffset(n);
        const uint t = MgTypeAt(GpuFluidLiqMgType, nb, dims, 0);
        const float air = LiqAirInvTheta(ownWord, n);
        if (t == GPU_FLUID_LIQUID_CELL_OUTSIDE)
        {
          if (LiqNeighbourSideOpen(n))
            diag += air;
        }
        else if (t == GPU_FLUID_LIQUID_CELL_LIQUID)
        {
          const uint nbIndex = LiqCellIndexIn(nb, dims);
          diag += 1.0;
          sum += asfloat(GpuFluidLiqPcgZ.Load(nbIndex * 4)) + beta * asfloat(GpuFluidLiqMgX.Load(nbIndex * 4));
        }
        else if (t == GPU_FLUID_LIQUID_CELL_AIR)
        {
          diag += air;
        }
      }
      p = asfloat(GpuFluidLiqPcgZ.Load(index * 4)) + beta * asfloat(GpuFluidLiqMgX.Load(index * 4));
      GpuFluidLiqPcgPOut.Store(index * 4, asuint(p));
    }
    else
    {
      MgStencil(GpuFluidLiqMgType, GpuFluidLiqMgX, cell, dims, 0, diag, sum);
      p = asfloat(GpuFluidLiqMgX.Load(index * 4));
    }
    const float q = diag * p - sum;
    GpuFluidLiqPcgQ.Store(index * 4, asuint(q));
    value = p * q;
  }
  PcgStorePartial(groupIndex, bCell, cell, value);
}
