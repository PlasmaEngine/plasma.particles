[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#define GPU_FLUID_LIQUID_BRICK_DISPATCH
#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidMultigrid.hlsli>

// Restriction from the fine grid to level 1, one group per active fine brick: each thread works out its fine cell's
// residual once into groupshared memory, then one thread per level-1 cell (the brick holds 4^3 of them, whose
// children all lie in it) sums its 2^3 children as LiquidRestrict does: liquid when it has a liquid child and no air
// child, the restricted residual as its b, x = 0.
//
// LiquidRestrict over the dense level-1 region worked out 8 fine residuals per coarse cell, each from the stencil of a
// child, and covered the air around the pool as well. Level-1 cells over inactive fine bricks are not written here;
// MgTypeAt reads them as air.
//
// GpuFluidLiqMgFineX/B/Type: the fine level's x (z of the preconditioner), b (r) and cell types. GpuFluidLiqMgX/B/Type:
// level 1. GpuFluidLiqPassF.y: scale of the restricted residual.

RWByteAddressBuffer GpuFluidLiqMgFineX;
RWByteAddressBuffer GpuFluidLiqMgFineB;
RWByteAddressBuffer GpuFluidLiqMgFineType;

groupshared float gs_fResidual[GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK];
groupshared uint gs_uiFlags[GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK * GPU_FLUID_LIQUID_BRICK]; // bit 0 liquid, bit 1 air

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES

  // The whole group takes the same branch: past the end of the brick list it leaves before the barrier.
  const uint4 args = GpuFluidLiqBrickArgs.Load4(0);
  const uint listIndex = GpuFluidLinearGroup(groupId, args.x);
  if (listIndex >= args.w)
    return;

  const uint brick = GpuFluidLiqBrickList.Load(listIndex * 4);
  const uint3 bricks = LiqBricks();
  const int3 origin = int3(uint3(brick % bricks.x, (brick / bricks.x) % bricks.y, brick / (bricks.x * bricks.y)) * GPU_FLUID_LIQUID_BRICK);
  const uint3 fineDims = LiqCells();

  // This thread's fine cell: liquid (with its residual), air, or neither (solid, or past the domain).
  const int3 cell = origin + int3(groupThreadId);
  const uint t = MgTypeAt(GpuFluidLiqMgFineType, cell, fineDims, 0);
  uint flags = 0;
  float residual = 0.0;
  if (t == GPU_FLUID_LIQUID_CELL_LIQUID)
  {
    flags = 1u;
    residual = MgResidual(GpuFluidLiqMgFineType, GpuFluidLiqMgFineX, GpuFluidLiqMgFineB, cell, fineDims, 0);
  }
  else if (t == GPU_FLUID_LIQUID_CELL_AIR)
  {
    flags = 2u;
  }
  gs_fResidual[groupIndex] = residual;
  gs_uiFlags[groupIndex] = flags;
  GroupMemoryBarrierWithGroupSync();

  // One thread per level-1 cell: the threads whose fine cell is the low corner of its 2^3 children.
  if (any((groupThreadId & 1u) != 0))
    return;
  const uint3 dims = LiqLevelDims(1);
  const int3 coarse = cell / 2;
  if (!LiqInsideDims(coarse, dims))
    return;

  float sum = 0.0;
  uint childFlags = 0;
  [unroll] for (uint o = 0; o < 8; ++o)
  {
    const uint3 child = groupThreadId + uint3(o & 1u, (o >> 1) & 1u, (o >> 2) & 1u);
    const uint childIndex = child.x + GPU_FLUID_LIQUID_BRICK * (child.y + GPU_FLUID_LIQUID_BRICK * child.z);
    sum += gs_fResidual[childIndex];
    childFlags |= gs_uiFlags[childIndex];
  }
  const bool bLiquid = (childFlags & 1u) != 0 && (childFlags & 2u) == 0;
  const uint type = bLiquid ? GPU_FLUID_LIQUID_CELL_LIQUID : ((childFlags & 2u) != 0 ? GPU_FLUID_LIQUID_CELL_AIR : GPU_FLUID_LIQUID_CELL_SOLID);
  const uint index = LiqCellIndexIn(coarse, dims);
  GpuFluidLiqMgType.Store(index * 4, type);
  GpuFluidLiqMgB.Store(index * 4, asuint(bLiquid ? MgRestrictScale() * sum : 0.0));
  GpuFluidLiqMgX.Store(index * 4, 0u);
}
