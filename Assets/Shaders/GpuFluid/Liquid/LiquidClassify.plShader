[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#define GPU_FLUID_LIQUID_BRICK_DISPATCH
#define GPU_FLUID_LIQUID_USE_SHAPES
#define GPU_FLUID_LIQUID_USE_REGIONS
#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidCells.hlsli>

// Cell types: solid when the centre is inside an analytic solid (the domain walls are faces, not cells); liquid, with
// the level set (GPU_FLUID_LIQUID_FLAG_LEVEL_SET), when phi < tau at its centre (or, in the P7 union mode, when it holds
// particles or phi < 0), so an empty cell inside the pool is liquid and not a hole of air the pressure drives a jet
// into, and a stray particle on a resting surface is not a cell of its own; without the level set when it holds
// particles; air otherwise.
//
// A liquid cell's type word also holds the free surface's theta towards each air neighbour (GpuFluidLiquidConstants.h):
// theta = (phi_i - tau) / (phi_i - phi_j) from the level set, at least the dispatch's minimum, which is also what a cell with
// particles but its centre outside the surface (phi_i >= 0: spray) gets; the constant code without the level set and
// towards an open domain side.
//
// Also the volume measure the global volume control compares with the seeded volume: a liquid cell surrounded by
// liquid, solid or wall counts as full, a surface cell as min(n / n0, 1).

RWByteAddressBuffer GpuFluidLiqCellType;
ByteAddressBuffer GpuFluidLiqCellCount;
ByteAddressBuffer GpuFluidLiqPhi;
RWByteAddressBuffer GpuFluidLiqCounters;

groupshared uint gs_uiVolume;
groupshared uint gs_uiLiquid;

/// Solid when the cell centre is inside an analytic shape or the baked static solids (binary: no face fractions).
bool IsSolidCell(int3 c)
{
  return LiqHasSolids() && LiqInside(c) && LiqSolidDistanceAtCell(c) < 0.0;
}

/// A cell whose centre is inside an open drain is air: the free surface's zero pressure there draws the liquid in.
bool IsDrainCell(int3 c)
{
  return LiqDrainCount() > 0 && LiqInsideDrain((float3(c) + 0.5) * LiqDx());
}

/// phi at the centre of cell c in cells, the far value (positive) where it was not computed this substep.
float PhiAt(int3 c)
{
  if (GpuFluidLiqBrickActive.Load(LiqBrickIndex(c) * 4) == 0)
    return 1.0e3;
  return asfloat(GpuFluidLiqPhi.Load(LiqCellIndex(c) * 4));
}

/// Whether the non-solid cell c inside the domain is liquid (with the level set): phi < tau (GpuFluidLiqPassF.y,
/// cells), or it holds at least GpuFluidLiqPass.y particles and phi < sigma (GpuFluidLiqPassF.z, cells; -1e3 when the
/// level set alone decides). Particles outside (loose ones on a resting surface, spray) are then not cells of their
/// own that the pressure has to hold up, and fly ballistically.
///
/// Next to an analytic solid a cell holding particles is liquid whatever phi says. The level set mirrors the particles at
/// the domain walls but not at solids, so beside a solid the mean particle position is pulled away from it and phi
/// reads too high: a pool's cells along the foot of a glass wall would be air, with the free surface's zero pressure
/// at the bottom of the pool, and the pressure would drive jets into them that carry particles through the wall.
bool IsLiquidCell(int3 c, uint count, float phi)
{
  if (IsDrainCell(c))
    return false;
  if (!LiqLevelSetEnabled())
    return count > 0;
  // A cell holding well over its share of particles is liquid whatever the level set says. In a domain corner the
  // particles mirrored at three walls put their mean on the corner itself, so phi reads positive at the centre of a
  // corner cell however full it is: it was air, its particles fell ballistic into the corner and stayed, and the corner
  // gathered 40K particles (the Flooding Room's water that never drained, and P2G at 100+ ms a frame).
  if (float(count) >= 2.0 * LiqParticlesPerCell())
    return true;
  if (phi < LIQ_CONST(GpuFluidLiqPassF).y || (count >= max(LIQ_CONST(GpuFluidLiqPass).y, 1u) && phi < LIQ_CONST(GpuFluidLiqPassF).z))
    return true;
  if (count == 0 || !LiqHasSolids())
    return false;
  [unroll] for (uint n = 0; n < 6; ++n)
  {
    if (IsSolidCell(c + LiqNeighbourOffset(n)))
      return true;
  }
  return false;
}

/// phi relative to the pressure's free surface, phi = tau.
float SurfacePhi(float phi)
{
  return phi - LIQ_CONST(GpuFluidLiqPassF).y;
}

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES
  if (groupIndex == 0)
  {
    gs_uiVolume = 0;
    gs_uiLiquid = 0;
  }
  GroupMemoryBarrierWithGroupSync();

  int3 cell;
  const bool bCell = LiqBrickCell(groupId, groupThreadId, cell);

  if (bCell)
  {
    const uint index = LiqCellIndex(cell);
    const uint count = GpuFluidLiqCellCount.Load(index * 4);
    const bool bSolid = IsSolidCell(cell);
    const bool bLevelSet = LiqLevelSetEnabled();
    const float phi = bLevelSet ? PhiAt(cell) : 0.0;
    // GpuFluidLiqPassF.x: the smallest theta (a free surface right at a cell centre would make 1 / theta, and the
    // pressure's sensitivity to the particles' noise, unbounded); GpuFluidLiqPass.x bit 0: theta from the level set at
    // all, else the constant.
    const float thetaMin = clamp(LIQ_CONST(GpuFluidLiqPassF).x, 1.0 / GPU_FLUID_LIQUID_THETA_STEPS, 1.0);
    const bool bLevelSetTheta = bLevelSet && (LIQ_CONST(GpuFluidLiqPass).x & 1u) != 0;
    const float surfacePhi = SurfacePhi(phi);

    uint type = GPU_FLUID_LIQUID_CELL_AIR;
    if (bSolid)
      type = GPU_FLUID_LIQUID_CELL_SOLID;
    else if (IsLiquidCell(cell, count, phi))
      type = GPU_FLUID_LIQUID_CELL_LIQUID;

    uint word = type;

    // Diagnostics: how the most crowded cell so far this frame (LiquidCount ran first) is classified.
    if ((GpuFluidLiqCounters.Load(GPU_FLUID_LIQUID_CTR_MAX_CELL * 4) & 0xFFFFFu) == (index & 0xFFFFFu))
    {
      GpuFluidLiqCounters.Store(GPU_FLUID_LIQUID_CTR_MAX_CELL_TYPE * 4, type | (count << 8));
      GpuFluidLiqCounters.Store(GPU_FLUID_LIQUID_CTR_MAX_CELL_PHI * 4, asuint(phi));
      GpuFluidLiqCounters.Store(GPU_FLUID_LIQUID_CTR_MAX_CELL_SDF * 4, asuint(LiqHasSolids() ? LiqSolidDistanceAtCell(cell) : 1.0e6));
    }

    // The volume measure keeps its own liquid cells, every cell holding particles plus the empty ones inside the level
    // set, whatever the pressure's cells are. With phi < tau alone for the pressure the measure's surface cells would
    // be the band tau adds above the particles, and the control would hold a pool at the wrong packing.
    const bool bMeasureLiquid = !bSolid && (count > 0 || (bLevelSet && phi < 0.0));
    const bool bLiquid = type == GPU_FLUID_LIQUID_CELL_LIQUID;

    if (bLiquid || bMeasureLiquid)
    {
      bool bInterior = true;
      [unroll] for (uint n = 0; n < 6; ++n)
      {
        const int3 nb = cell + LiqNeighbourOffset(n);
        uint code = GPU_FLUID_LIQUID_THETA_CONSTANT;
        if (!LiqInside(nb))
        {
          // Outside the domain: a wall counts as solid, an open side as air (constant theta).
          bInterior = bInterior && !LiqNeighbourSideOpen(n);
        }
        else
        {
          const uint nbCount = GpuFluidLiqCellCount.Load(LiqCellIndex(nb) * 4);
          const float nbPhi = bLevelSet ? PhiAt(nb) : 0.0;
          const bool bNbSolid = IsSolidCell(nb);
          const bool bNbLiquid = !bNbSolid && IsLiquidCell(nb, nbCount, nbPhi);
          const bool bNbMeasureLiquid = !bNbSolid && (nbCount > 0 || (bLevelSet && nbPhi < 0.0));
          bInterior = bInterior && (bNbMeasureLiquid || bNbSolid);

          if (bLevelSetTheta && !bNbSolid && !bNbLiquid)
          {
            // The neighbour is air. The surface lies theta of the way from this centre to the neighbour's.
            const float nbSurfacePhi = SurfacePhi(nbPhi);
            const float theta = surfacePhi < 0.0 ? surfacePhi / min(surfacePhi - nbSurfacePhi, -1.0e-6) : 0.0;
            const float t = clamp(theta, thetaMin, 1.0);
            code = clamp((uint)round(t * GPU_FLUID_LIQUID_THETA_STEPS), 1u, (uint)GPU_FLUID_LIQUID_THETA_STEPS);
          }
        }
        if (bLiquid)
          word |= code << (GPU_FLUID_LIQUID_THETA_SHIFT + GPU_FLUID_LIQUID_THETA_BITS * n);
      }

      if (bMeasureLiquid)
      {
        const float fill = bInterior ? 1.0 : saturate(float(count) / LiqParticlesPerCell());
        InterlockedAdd(gs_uiVolume, (uint)round(fill * GPU_FLUID_LIQUID_VOLUME_SCALE));
      }
      if (bLiquid)
        InterlockedAdd(gs_uiLiquid, 1u);
    }

    GpuFluidLiqCellType.Store(index * 4, word);
  }

  GroupMemoryBarrierWithGroupSync();

  if (groupIndex == 0 && (gs_uiLiquid > 0 || gs_uiVolume > 0))
  {
    GpuFluidLiqCounters.InterlockedAdd(GPU_FLUID_LIQUID_CTR_VOLUME * 4, gs_uiVolume);
    GpuFluidLiqCounters.InterlockedAdd(GPU_FLUID_LIQUID_CTR_LIQUID_CELLS * 4, gs_uiLiquid);
  }
}
