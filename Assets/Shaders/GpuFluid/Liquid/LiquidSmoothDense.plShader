[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidMultigrid.hlsli>

// One colour of a red-black Gauss-Seidel sweep on a coarse level, dense.

[numthreads(GPU_FLUID_LIQUID_LEVEL_GROUP, GPU_FLUID_LIQUID_LEVEL_GROUP, GPU_FLUID_LIQUID_LEVEL_GROUP)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  const uint3 dims = LiqLevelDims(MgLevel());
  const int3 cell = int3(dispatchThreadId);
  if (!LiqInsideDims(cell, dims))
    return;

  MgSmoothCell(cell, dims, false);
}
