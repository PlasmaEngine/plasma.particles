[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidSurface.hlsli>

// One clamped Laplacian smoothing step of the surface level set: phi += clamp(k (mean of the 6 neighbours - phi), -c,
// c), without changing phi's sign, so thin sheets, streams and small drops are smoothed, not erased. Neighbours outside the domain or in inactive bricks count as the cell itself (no pull towards
// the walls).
//
// GpuFluidLiqSurfPhi in, GpuFluidLiqPhiOut out. GpuFluidLiqPassF: x outside value, y far value, z k, w c (cells).

RWByteAddressBuffer GpuFluidLiqPhiOut;

[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
  int3 cell;
  if (!LiqBrickCell(groupId, groupThreadId, cell))
    return;

  const float4 params = LIQ_CONST(GpuFluidLiqPassF);
  const uint index = LiqCellIndex(cell);
  const float phi = asfloat(GpuFluidLiqSurfPhi.Load(index * 4));

  float sum = 0.0;
  [unroll] for (uint n = 0; n < 6; ++n)
  {
    const int3 nb = cell + LiqNeighbourOffset(n);
    const bool bKnown = LiqInside(nb) && GpuFluidLiqBrickActive.Load(LiqBrickIndex(nb) * 4) != 0;
    sum += bKnown ? asfloat(GpuFluidLiqSurfPhi.Load(LiqCellIndex(nb) * 4)) : phi;
  }

  // A sample keeps its side of the surface: smoothing moves the crossings inside the cells, never which samples are
  // liquid. Left free, it is a mean-curvature flow that eats a stream two cells across in a step or two, and fills a
  // dent the particles really have.
  const float delta = clamp(params.z * (sum / 6.0 - phi), -params.w, params.w);
  const float smoothed = phi < 0.0 ? min(phi + delta, -0.01) : max(phi + delta, 0.01);
  GpuFluidLiqPhiOut.Store(index * 4, asuint(smoothed));
}
