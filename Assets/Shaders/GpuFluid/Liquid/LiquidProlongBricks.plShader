[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#define GPU_FLUID_LIQUID_BRICK_DISPATCH
#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/GpuFluid/Liquid/GpuFluidLiquidMultigrid.hlsli>

// Prolongation of the level-1 correction onto the fine level (active bricks): piecewise constant, liquid cells only.

RWByteAddressBuffer GpuFluidLiqMgCoarseX;

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK, GPU_FLUID_LIQUID_BRICK)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID)
{
  GPU_FLUID_KERNEL_MODES
  int3 cell;
  if (!LiqBrickCell(groupId, groupThreadId, cell))
    return;

  const uint3 dims = LiqCells();
  const uint index = LiqCellIndexIn(cell, dims);
  if ((GpuFluidLiqMgType.Load(index * 4) & 3u) != GPU_FLUID_LIQUID_CELL_LIQUID)
    return;

  const float correction = asfloat(GpuFluidLiqMgCoarseX.Load(LiqCellIndexIn(cell / 2, LiqLevelDims(1)) * 4));
  GpuFluidLiqMgX.Store(index * 4, asuint(asfloat(GpuFluidLiqMgX.Load(index * 4)) + correction));
}
