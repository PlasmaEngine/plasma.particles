[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/GpuFluid/GpuFluidPressure.hlsli>

// Phase Gas/Pressure, last kernel: u -= grad Phi on every face, in place. One 8 cubed group per active brick (indirect),
// one thread per cell, which owns the cell's three -side faces (its own texel).
//
// By the face's code (GpuFluidPressure.hlsli): FLUID faces get the difference of the two cells' Phi, DIRICHLET faces
// see Phi = 0 on the far side, WALL faces carry no flow, SOLID faces keep the solid's velocity GasSolids gave them.
// Where the +side neighbour of a brick's last cell is missing, that boundary face lives in the brick's apron; the
// cell's thread projects it there too, and GasHalo's keep mode leaves it alone afterwards. No two threads write the
// same texel: the -side faces are interior texels, the +side faces distinct apron texels.

RWTexture3D<float4> GpuFluidVelocityTarget;
RWStructuredBuffer<float> GpuFluidPressure;   // only read here
RWStructuredBuffer<uint> GpuFluidFaceCodes;   // only read here

[numthreads(GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  const uint slot = GpuFluidGroupSlot(groupId);
  if (slot == GPU_FLUID_INVALID_SLOT)
    return;

  const float invDx = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasStep).z;
  const int3 local = int3(groupThreadId);
  const int3 texel = GpuFluidTexel(slot, local);
  const uint index = slot * GPU_FLUID_BRICK_CELLS + groupIndex;
  const uint codes = GpuFluidFaceCodes[index];
  const float phi = GpuFluidPressure[index];

  float4 velocity = GpuFluidVelocityTarget[texel];

  [unroll] for (uint axis = 0; axis < 3; ++axis)
  {
    // -side face: between this cell and the one below it on this axis.
    const uint below = GpuFluidFaceCode(codes, axis * 2);
    if (below == GPU_FLUID_CODE_FLUID)
      velocity[axis] -= (phi - GpuFluidNeighborPhi(GpuFluidPressure, slot, local, axis, -1)) * invDx;
    else if (below == GPU_FLUID_CODE_DIRICHLET)
      velocity[axis] -= phi * invDx;
    else if (below == GPU_FLUID_CODE_WALL)
      velocity[axis] = 0.0;

    // +side face of the brick's last cell, against a missing neighbour: the apron texel.
    if (local[axis] == GPU_FLUID_BRICK_SIZE - 1)
    {
      int3 d = int3(0, 0, 0);
      d[axis] = 1;
      if (GpuFluidNeighbor(slot, d) >= GPU_FLUID_NEIGHBOR_OUTSIDE)
      {
        const uint above = GpuFluidFaceCode(codes, axis * 2 + 1);
        int3 apron = texel;
        apron[axis] += 1;
        float4 boundary = GpuFluidVelocityTarget[apron];
        if (above == GPU_FLUID_CODE_DIRICHLET)
          boundary[axis] += phi * invDx; // (0 - Phi) / dx subtracted
        else if (above == GPU_FLUID_CODE_WALL)
          boundary[axis] = 0.0;
        GpuFluidVelocityTarget[apron] = boundary;
      }
    }
  }

  GpuFluidVelocityTarget[texel] = velocity;
}
