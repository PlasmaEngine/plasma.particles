[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/GpuFluid/GpuFluidPressure.hlsli>

// Phase Gas/Pressure, last kernel: u -= grad Phi on every face, in place. One 8 cubed group per active brick (indirect),
// one thread per cell, which owns the cell's three -side faces (its own texel).
//
// A face against a closed wall carries no flow. A face against open air (an open domain face or an unallocated brick)
// sees Phi = 0 on the far side. Where the +side neighbour of a brick's last cell is missing, that boundary face lives in
// the brick's apron; the cell's thread projects it there too, and GasHalo's keep mode leaves it alone afterwards. No two
// threads write the same texel: the -side faces are interior texels, the +side faces distinct apron texels.

RWTexture3D<float4> GpuFluidVelocityTarget;
RWStructuredBuffer<float> GpuFluidPressure; // only read here, but shares the helper with the solver

[numthreads(GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  const uint slot = GpuFluidGroupSlot(groupId);
  if (slot == GPU_FLUID_INVALID_SLOT)
    return;

  const float invDx = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasStep).z;
  const int3 local = int3(groupThreadId);
  const int3 texel = GpuFluidTexel(slot, local);
  const float phi = GpuFluidPressure[slot * GPU_FLUID_BRICK_CELLS + groupIndex];

  float4 velocity = GpuFluidVelocityTarget[texel];

  [unroll] for (uint axis = 0; axis < 3; ++axis)
  {
    // -side face: between this cell and the one below it on this axis.
    float phiBelow;
    if (GpuFluidNeighborPressure(GpuFluidPressure, slot, local, axis, -1, phiBelow))
      velocity[axis] -= (phi - phiBelow) * invDx;
    else
      velocity[axis] = 0.0; // closed wall

    // +side face of the brick's last cell, against a missing neighbour: the apron texel.
    if (local[axis] == GPU_FLUID_BRICK_SIZE - 1)
    {
      int3 d = int3(0, 0, 0);
      d[axis] = 1;
      const uint neighbor = GpuFluidNeighbor(slot, d);
      if (neighbor >= GPU_FLUID_NEIGHBOR_OUTSIDE)
      {
        const bool bOpen = neighbor == GPU_FLUID_NEIGHBOR_UNALLOCATED || GpuFluidFaceOpen(axis, 1);

        int3 apron = texel;
        apron[axis] += 1;
        float4 boundary = GpuFluidVelocityTarget[apron];
        boundary[axis] = bOpen ? boundary[axis] + phi * invDx : 0.0; // (0 - Phi) / dx subtracted
        GpuFluidVelocityTarget[apron] = boundary;
      }
    }
  }

  GpuFluidVelocityTarget[texel] = velocity;
}
