[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/Common/Common.h>

#define GPU_FLUID_SPARSE_WRITABLE
#include <Shaders/GpuFluid/GpuFluidSparse.hlsli>

// Phase Gas/Alloc of a gas volume: the sparse allocator (design plan section 3). Once per frame that runs ticks, before
// them; the modes run in this order (GpuFluidGasPass.x), the two scans (GpuFluidScan) in between:
//
//  0 INIT          once, when the volume is created: no brick has a slot, every pool slot is free, the brick table, the
//                  requests and the per-slot meta are zero. One thread per item of the largest of those.
//  1 RESET         the grid counters to 0. One group.
//  2 MARK_EMITTERS bucket 0 for the CPU-binned bricks the sources overlap this frame. One thread per list entry.
//  3 MARK_ALL      bucket 0 for every brick of the grid (AllocateAll: the closed-box mode keeps the whole box). One thread
//                  per request word.
//  4 FREE          every slot with a brick: no request in any bucket this frame adds one to its idle steps, any request
//                  resets them; at GPU_FLUID_FREE_IDLE_STEPS the slot is freed (page entry, brick table texel, meta; the
//                  mass it still held is counted as dropped). Writes 1 for every slot that is free afterwards into the
//                  slot scan, counts them, and flags every slot without a source request in its eviction class (idle,
//                  proximity only, flux, content). One thread per pool slot.
//  5 PENDING       the requests for bricks without a slot, each in the first bucket that asked for it, and their count
//                  per word (the request scan's input); clears the requests for the next Finalize. One thread per
//                  request word.
//    [scan of the pending counts -> first rank per word, total R; scan of the eviction flags -> rank by class, slot]
// 11 EVICT         when the sources' pending bricks (bucket 0) outnumber the free slots, the evictable slots of rank below
//                  the difference are freed like FREE does, so a source never starves behind thin gas or margins.
//    [scan of the free flags -> free rank per slot, total F]
//  6 FREE_LIST     the free slots in ascending order (descending with Pass.w bit 0, a test hook that gives every brick
//                  other slots): free list[rank] = slot. One thread per pool slot.
//  7 ASSIGN        request k (bucket order, then virtual index) takes free slot k while k < F, else it is denied (counted
//                  per bucket). A new slot gets its page entry, brick, meta and brick table texel (A = 0), and goes on the
//                  new list, which GasClear clears. One thread per bucket word.
//  8 LISTS         the active list in ascending slot order (rank from the free scan: no atomics, so it does not depend on
//                  group order), the 27-entry neighbour table and the brick colour lists. One thread per pool slot.
//  9 ARGS          dispatch arguments (every active brick, the same in slabs, the new list; the colours), and the frame's
//                  allocation numbers into the stats. One thread.
// 10 DEBUG         the grid debug readback (N1, the brick view): counters, per slot brick and meta, the active list and,
//                  when Params0.z is 1, per virtual brick the page entry and the brick table's A. One thread per item.
//
// Every count is an integer atomic and every slot choice comes from a scan, so the allocation is the same whatever order
// the groups run in, and the same for every pool size while the pool has room (N11).
//
// Pass: y request words per bucket, z emitter list entries, w bit 0 free list in descending slot order (test hook).
// Params0: x byte offset of the free total in the
// slot scan's scratch, y byte offset of the request total in the request scan's scratch, z 1: the debug readback's
// virtual part.

#define GPU_FLUID_ALLOC_INIT 0
#define GPU_FLUID_ALLOC_RESET 1
#define GPU_FLUID_ALLOC_MARK_EMITTERS 2
#define GPU_FLUID_ALLOC_MARK_ALL 3
#define GPU_FLUID_ALLOC_FREE 4
#define GPU_FLUID_ALLOC_PENDING 5
#define GPU_FLUID_ALLOC_FREE_LIST 6
#define GPU_FLUID_ALLOC_ASSIGN 7
#define GPU_FLUID_ALLOC_LISTS 8
#define GPU_FLUID_ALLOC_ARGS 9
#define GPU_FLUID_ALLOC_DEBUG 10
#define GPU_FLUID_ALLOC_EVICT 11

RWStructuredBuffer<uint> GpuFluidPageTableOutput;
RWStructuredBuffer<uint> GpuFluidActiveListOutput;
RWStructuredBuffer<uint> GpuFluidBrickCoordsOutput;
RWStructuredBuffer<uint> GpuFluidNeighborsOutput;
RWStructuredBuffer<uint> GpuFluidCountersOutput;
RWStructuredBuffer<uint> GpuFluidDispatchArgsOutput;
RWStructuredBuffer<uint> GpuFluidColourListOutput;
RWStructuredBuffer<uint> GpuFluidColourArgsOutput;
RWTexture3D<float4> GpuFluidIndirectionOutput; // RGBA16F: rgb = atlas brick / 255, a = brick mean (0 = empty)

RWByteAddressBuffer GpuFluidRequests;          // 4 buckets of request words
RWStructuredBuffer<uint> GpuFluidPending;      // 4 buckets of request words for bricks without a slot
RWByteAddressBuffer GpuFluidRequestScan;       // per bucket word: pending count, scanned in place to the first rank
RWByteAddressBuffer GpuFluidRequestScratch;    // the request scan's block sums and total
RWByteAddressBuffer GpuFluidSlotScan;          // per pool slot: 1 when free, scanned in place to the free rank
RWByteAddressBuffer GpuFluidSlotScratch;       // the slot scan's block sums and total
RWStructuredBuffer<uint> GpuFluidFreeList;     // rank -> free slot
RWStructuredBuffer<uint> GpuFluidNewList;      // slots assigned this frame
RWStructuredBuffer<uint> GpuFluidBrickMeta;    // 4 words per slot (GPU_FLUID_META_*)
StructuredBuffer<uint> GpuFluidEmitterBricks;  // linear virtual bricks the sources overlap
RWByteAddressBuffer GpuFluidStats;
RWStructuredBuffer<uint> GpuFluidGridDebug;
RWByteAddressBuffer GpuFluidEvictScan;         // per eviction class and pool slot: 1 when evictable, scanned in place to the rank

void WriteArgs(uint first, uint count, uint z)
{
  const uint groupsX = min(count, (uint)GPU_FLUID_DISPATCH_FOLD);
  const uint groupsY = (count + GPU_FLUID_DISPATCH_FOLD - 1) / GPU_FLUID_DISPATCH_FOLD;
  GpuFluidDispatchArgsOutput[first + 0] = max(groupsX, 1u);
  GpuFluidDispatchArgsOutput[first + 1] = max(groupsY, 1u);
  GpuFluidDispatchArgsOutput[first + 2] = z;
  GpuFluidDispatchArgsOutput[first + 3] = count;
}

void WriteColourArgs(uint first, uint count)
{
  const uint groupsX = min(count, (uint)GPU_FLUID_DISPATCH_FOLD);
  const uint groupsY = (count + GPU_FLUID_DISPATCH_FOLD - 1) / GPU_FLUID_DISPATCH_FOLD;
  GpuFluidColourArgsOutput[first + 0] = max(groupsX, 1u);
  GpuFluidColourArgsOutput[first + 1] = max(groupsY, 1u);
  GpuFluidColourArgsOutput[first + 2] = 1;
  GpuFluidColourArgsOutput[first + 3] = count;
}

uint3 BrickOfLinear(uint index, uint3 grid)
{
  return uint3(index % grid.x, (index / grid.x) % grid.y, index / (grid.x * grid.y));
}

bool IsRequested(uint bucket, uint brickLinear, uint words)
{
  const uint word = GpuFluidRequests.Load((bucket * words + (brickLinear >> 5)) * 4);
  return (word & (1u << (brickLinear & 31u))) != 0;
}

/// Takes a slot's brick away (freeing or eviction): page entry, brick, brick table texel and meta. The gas the brick still
/// held at the last Finalize is counted as dropped.
void FreeSlot(uint slot, uint3 brick, uint brickLinear)
{
  const uint mass = GpuFluidBrickMeta[slot * 4 + GPU_FLUID_META_MASS];
  if (mass > 0)
    GpuFluidStats.InterlockedAdd(GPU_FLUID_STAT_MASS_DROPPED * 4, mass);

  GpuFluidPageTableOutput[brickLinear] = GPU_FLUID_INVALID_SLOT;
  GpuFluidBrickCoordsOutput[slot] = GPU_FLUID_INVALID_SLOT;
  GpuFluidIndirectionOutput[brick] = float4(0.0, 0.0, 0.0, 0.0);
  [unroll] for (uint i = 0; i < 4; ++i)
    GpuFluidBrickMeta[slot * 4 + i] = 0;
}

GPU_FLUID_KERNEL_CAPS
[numthreads(64, 1, 1)]
void main(uint3 dispatchThreadId : SV_DispatchThreadID)
{
  GPU_FLUID_KERNEL_MODES
  const uint4 pass = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasPass);
  const float4 params = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasParams0);
  const uint mode = pass.x;
  const uint words = pass.y;
  const uint3 grid = GpuFluidGrid();
  const uint virtualBricks = grid.x * grid.y * grid.z;
  const uint capacity = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasGrid).w;
  const uint index = dispatchThreadId.x;

  if (mode == GPU_FLUID_ALLOC_INIT)
  {
    if (index < virtualBricks)
    {
      GpuFluidPageTableOutput[index] = GPU_FLUID_INVALID_SLOT;
      GpuFluidIndirectionOutput[BrickOfLinear(index, grid)] = float4(0.0, 0.0, 0.0, 0.0);
    }
    if (index < capacity)
    {
      GpuFluidBrickCoordsOutput[index] = GPU_FLUID_INVALID_SLOT;
      GpuFluidActiveListOutput[index] = GPU_FLUID_INVALID_SLOT;
      [unroll] for (uint i = 0; i < 4; ++i)
        GpuFluidBrickMeta[index * 4 + i] = 0;
    }
    if (index < GPU_FLUID_ALLOC_BUCKETS * words)
      GpuFluidRequests.Store(index * 4, 0u);
    if (index < GPU_FLUID_ARGS_TOTAL_WORDS)
      GpuFluidDispatchArgsOutput[index] = (index % GPU_FLUID_ARGS_WORDS) == 3 ? 0u : 1u;
    if (index < 2 * GPU_FLUID_ARGS_WORDS)
      GpuFluidColourArgsOutput[index] = (index % GPU_FLUID_ARGS_WORDS) == 3 ? 0u : 1u;
    return;
  }

  if (mode == GPU_FLUID_ALLOC_RESET)
  {
    if (index < GPU_FLUID_COUNTER_WORDS)
      GpuFluidCountersOutput[index] = 0;
    return;
  }

  if (mode == GPU_FLUID_ALLOC_MARK_EMITTERS)
  {
    if (index >= pass.z)
      return;
    const uint brickLinear = GpuFluidEmitterBricks[index];
    if (brickLinear >= virtualBricks)
      return;
    uint previous;
    GpuFluidRequests.InterlockedOr((GPU_FLUID_BUCKET_EMITTER * words + (brickLinear >> 5)) * 4, 1u << (brickLinear & 31u), previous);
    return;
  }

  if (mode == GPU_FLUID_ALLOC_MARK_ALL)
  {
    if (index >= words)
      return;
    const uint first = index * 32;
    const uint valid = virtualBricks > first ? min(virtualBricks - first, 32u) : 0u;
    const uint bits = valid >= 32 ? 0xFFFFFFFFu : ((1u << valid) - 1u);
    uint previous;
    GpuFluidRequests.InterlockedOr((GPU_FLUID_BUCKET_EMITTER * words + index) * 4, bits, previous);
    return;
  }

  if (mode == GPU_FLUID_ALLOC_FREE)
  {
    if (index >= capacity)
      return;

    // The eviction classes of this slot: none unless it keeps a brick no source overlaps.
    [unroll] for (uint c = 0; c < GPU_FLUID_EVICT_CLASSES; ++c)
      GpuFluidEvictScan.Store((c * capacity + index) * 4, 0u);

    uint previous;
    const uint packed = GpuFluidBrickCoordsOutput[index];
    if (packed == GPU_FLUID_INVALID_SLOT)
    {
      GpuFluidSlotScan.Store(index * 4, 1u);
      InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_FREE], 1u, previous);
      return;
    }

    const uint3 brick = GpuFluidUnpackBrick(packed);
    const uint brickLinear = GpuFluidBrickLinear(brick, grid);

    uint buckets = 0;
    [unroll] for (uint b = 0; b < GPU_FLUID_ALLOC_BUCKETS; ++b)
    {
      if (IsRequested(b, brickLinear, words))
        buckets |= 1u << b;
    }

    const uint idle = buckets != 0 ? 0u : (GpuFluidBrickMeta[index * 4 + GPU_FLUID_META_BUCKETS] >> GPU_FLUID_META_IDLE_SHIFT) + 1;
    if (idle >= GPU_FLUID_FREE_IDLE_STEPS)
    {
      FreeSlot(index, brick, brickLinear);
      GpuFluidSlotScan.Store(index * 4, 1u);
      InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_FREED], 1u, previous);
      InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_FREE], 1u, previous);
      return;
    }

    GpuFluidBrickMeta[index * 4 + GPU_FLUID_META_BUCKETS] = buckets | (idle << GPU_FLUID_META_IDLE_SHIFT);
    GpuFluidSlotScan.Store(index * 4, 0u);

    // A source's brick is never evicted; the others by class: idle, proximity only, flux, content.
    if ((buckets & (1u << GPU_FLUID_BUCKET_EMITTER)) == 0)
    {
      uint evictClass = 3;
      if (buckets == 0)
        evictClass = 0;
      else if (buckets == (1u << GPU_FLUID_BUCKET_PROXIMITY))
        evictClass = 1;
      else if ((buckets & (1u << GPU_FLUID_BUCKET_ALIVE)) == 0)
        evictClass = 2;
      GpuFluidEvictScan.Store((evictClass * capacity + index) * 4, 1u);
    }
    return;
  }

  if (mode == GPU_FLUID_ALLOC_PENDING)
  {
    if (index >= words)
      return;

    uint bits[GPU_FLUID_ALLOC_BUCKETS];
    uint any = 0;
    [unroll] for (uint b = 0; b < GPU_FLUID_ALLOC_BUCKETS; ++b)
    {
      bits[b] = GpuFluidRequests.Load((b * words + index) * 4);
      any |= bits[b];
      GpuFluidRequests.Store((b * words + index) * 4, 0u);
    }

    // Which of the requested bricks have no slot yet.
    uint unallocated = 0;
    uint scan = any;
    while (scan != 0)
    {
      const uint bit = firstbitlow(scan);
      scan &= scan - 1u;
      const uint brickLinear = index * 32 + bit;
      if (brickLinear < virtualBricks && GpuFluidPageTableOutput[brickLinear] == GPU_FLUID_INVALID_SLOT)
        unallocated |= 1u << bit;
    }

    uint seen = 0;
    [unroll] for (uint b2 = 0; b2 < GPU_FLUID_ALLOC_BUCKETS; ++b2)
    {
      const uint pending = bits[b2] & ~seen & unallocated;
      seen |= bits[b2];
      GpuFluidPending[b2 * words + index] = pending;
      GpuFluidRequestScan.Store((b2 * words + index) * 4, countbits(pending));
      if (pending != 0)
      {
        uint previous;
        InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_REQUESTS_BUCKET + b2], countbits(pending), previous);
      }
    }
    return;
  }

  if (mode == GPU_FLUID_ALLOC_EVICT)
  {
    if (index >= capacity)
      return;

    // The sources' bricks that the free slots cannot hold.
    const uint sourceRequests = GpuFluidCountersOutput[GPU_FLUID_COUNTER_REQUESTS_BUCKET + GPU_FLUID_BUCKET_EMITTER];
    const uint freeSlots = GpuFluidCountersOutput[GPU_FLUID_COUNTER_FREE];
    const uint deficit = sourceRequests > freeSlots ? sourceRequests - freeSlots : 0u;
    if (deficit == 0)
      return;

    const uint packed = GpuFluidBrickCoordsOutput[index];
    if (packed == GPU_FLUID_INVALID_SLOT)
      return;
    const uint buckets = GpuFluidBrickMeta[index * 4 + GPU_FLUID_META_BUCKETS] & GPU_FLUID_META_BUCKET_BITS;
    if ((buckets & (1u << GPU_FLUID_BUCKET_EMITTER)) != 0)
      return;

    uint evictClass = 3;
    if (buckets == 0)
      evictClass = 0;
    else if (buckets == (1u << GPU_FLUID_BUCKET_PROXIMITY))
      evictClass = 1;
    else if ((buckets & (1u << GPU_FLUID_BUCKET_ALIVE)) == 0)
      evictClass = 2;

    // Rank among the evictable slots, by class and then slot index.
    if (GpuFluidEvictScan.Load((evictClass * capacity + index) * 4) >= deficit)
      return;

    const uint3 brick = GpuFluidUnpackBrick(packed);
    FreeSlot(index, brick, GpuFluidBrickLinear(brick, grid));
    GpuFluidSlotScan.Store(index * 4, 1u);

    uint previous;
    InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_EVICTED], 1u, previous);
    return;
  }

  const uint freeTotal = GpuFluidSlotScratch.Load(uint(params.x));
  const uint requestTotal = GpuFluidRequestScratch.Load(uint(params.y));
  const uint assigned = min(freeTotal, requestTotal);
  const bool bReverseSlots = (pass.w & 1u) != 0;

  if (mode == GPU_FLUID_ALLOC_FREE_LIST)
  {
    if (index < capacity && GpuFluidBrickCoordsOutput[index] == GPU_FLUID_INVALID_SLOT)
    {
      const uint freeRank = GpuFluidSlotScan.Load(index * 4);
      GpuFluidFreeList[bReverseSlots ? freeTotal - 1 - freeRank : freeRank] = index;
    }
    return;
  }

  if (mode == GPU_FLUID_ALLOC_ASSIGN)
  {
    if (index >= GPU_FLUID_ALLOC_BUCKETS * words)
      return;

    uint bits = GpuFluidPending[index];
    if (bits == 0)
      return;

    const uint bucket = index / words;
    const uint word = index % words;
    uint rank = GpuFluidRequestScan.Load(index * 4);
    uint denied = 0;

    while (bits != 0)
    {
      const uint bit = firstbitlow(bits);
      bits &= bits - 1u;
      const uint brickLinear = word * 32 + bit;

      if (rank < freeTotal)
      {
        const uint slot = GpuFluidFreeList[rank];
        const uint3 brick = BrickOfLinear(brickLinear, grid);
        GpuFluidPageTableOutput[brickLinear] = slot;
        GpuFluidBrickCoordsOutput[slot] = GpuFluidPackBrick(brick);
        GpuFluidBrickMeta[slot * 4 + GPU_FLUID_META_MASS] = 0;
        GpuFluidBrickMeta[slot * 4 + GPU_FLUID_META_ALIVE] = 0;
        GpuFluidBrickMeta[slot * 4 + GPU_FLUID_META_MASK] = 0;
        GpuFluidBrickMeta[slot * 4 + GPU_FLUID_META_BUCKETS] = 1u << bucket;
        // A stays 0 until Finalize has seen content: an empty brick is skipped by the march.
        GpuFluidIndirectionOutput[brick] = float4(float3(GpuFluidSlotToAtlasBrick(slot, GpuFluidAtlasBricks())) / 255.0, 0.0);

        uint position;
        InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_NEW], 1u, position);
        GpuFluidNewList[position] = slot;
      }
      else
      {
        ++denied;
      }
      ++rank;
    }

    if (denied > 0)
    {
      uint previous;
      InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_DENIED], denied, previous);
      InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_DENIED_BUCKET + bucket], denied, previous);
    }
    return;
  }

  if (mode == GPU_FLUID_ALLOC_LISTS)
  {
    if (index >= capacity)
      return;

    const uint packed = GpuFluidBrickCoordsOutput[index];
    if (packed == GPU_FLUID_INVALID_SLOT)
      return;

    // Slots below this one that hold a brick now: the ones that already did, plus the free ones that were assigned
    // (assignment takes the free slots in ascending order, or the last ones in descending order).
    const uint freeBefore = GpuFluidSlotScan.Load(index * 4);
    const uint firstAssignedRank = freeTotal - assigned;
    const uint assignedBefore = bReverseSlots ? max(freeBefore, firstAssignedRank) - firstAssignedRank : min(freeBefore, assigned);
    const uint rank = (index - freeBefore) + assignedBefore;
    GpuFluidActiveListOutput[rank] = index;

    const int3 brick = int3(GpuFluidUnpackBrick(packed));

    // The brick colour lists (the order inside a colour does not matter, no kernel depends on it).
    {
      const uint colour = uint(brick.x + brick.y + brick.z) & 1u;
      uint position;
      InterlockedAdd(GpuFluidCountersOutput[GPU_FLUID_COUNTER_COLOUR0 + colour], 1u, position);
      GpuFluidColourListOutput[colour == 0 ? position : capacity - 1 - position] = index;
    }

    for (int n = 0; n < GPU_FLUID_NEIGHBOR_COUNT; ++n)
    {
      const int3 d = int3(n % 3, (n / 3) % 3, n / 9) - 1;
      const int3 other = brick + d;

      uint value;
      if (any(other < 0) || any(other >= int3(grid)))
        value = GPU_FLUID_NEIGHBOR_OUTSIDE;
      else
      {
        const uint otherSlot = GpuFluidPageTableOutput[GpuFluidBrickLinear(uint3(other), grid)];
        value = otherSlot == GPU_FLUID_INVALID_SLOT ? GPU_FLUID_NEIGHBOR_UNALLOCATED : otherSlot;
      }

      GpuFluidNeighborsOutput[index * GPU_FLUID_NEIGHBOR_COUNT + n] = value;
    }
    return;
  }

  if (mode == GPU_FLUID_ALLOC_ARGS)
  {
    if (index != 0)
      return;

    const uint active = (capacity - freeTotal) + assigned;
    GpuFluidCountersOutput[GPU_FLUID_COUNTER_ACTIVE] = active;
    WriteArgs(GPU_FLUID_ARGS_ACTIVE, active, 1);
    WriteArgs(GPU_FLUID_ARGS_SLABS, active, GPU_FLUID_SLABS);
    WriteArgs(GPU_FLUID_ARGS_NEW, assigned, 1);
    WriteArgs(GPU_FLUID_ARGS_NEW_SLABS, assigned, GPU_FLUID_SLABS);
    WriteColourArgs(0, GpuFluidCountersOutput[GPU_FLUID_COUNTER_COLOUR0]);
    WriteColourArgs(GPU_FLUID_ARGS_WORDS, GpuFluidCountersOutput[GPU_FLUID_COUNTER_COLOUR1]);

    GpuFluidStats.Store(GPU_FLUID_STAT_SLOTS_REQUESTED * 4, requestTotal + (capacity - freeTotal));
    GpuFluidStats.Store(GPU_FLUID_STAT_DENIED * 4, GpuFluidCountersOutput[GPU_FLUID_COUNTER_DENIED]);
    GpuFluidStats.Store(GPU_FLUID_STAT_ALLOC_NEW * 4, assigned);
    GpuFluidStats.Store(GPU_FLUID_STAT_ALLOC_FREED * 4, GpuFluidCountersOutput[GPU_FLUID_COUNTER_FREED]);
    GpuFluidStats.Store(GPU_FLUID_STAT_ALLOC_FREE * 4, freeTotal);
    GpuFluidStats.Store(GPU_FLUID_STAT_ALLOC_REQUESTS * 4, requestTotal);
    GpuFluidStats.Store(GPU_FLUID_STAT_ALLOC_ACTIVE * 4, active);
    GpuFluidStats.Store(GPU_FLUID_STAT_ALLOC_EVICTED * 4, GpuFluidCountersOutput[GPU_FLUID_COUNTER_EVICTED]);
    [unroll] for (uint b = 0; b < GPU_FLUID_ALLOC_BUCKETS; ++b)
    {
      GpuFluidStats.Store((GPU_FLUID_STAT_DENIED_BUCKET + b) * 4, GpuFluidCountersOutput[GPU_FLUID_COUNTER_DENIED_BUCKET + b]);
      GpuFluidStats.Store((GPU_FLUID_STAT_REQUESTS_BUCKET + b) * 4, GpuFluidCountersOutput[GPU_FLUID_COUNTER_REQUESTS_BUCKET + b]);
    }
    return;
  }

  if (mode == GPU_FLUID_ALLOC_DEBUG)
  {
    if (index < GPU_FLUID_COUNTER_WORDS)
      GpuFluidGridDebug[index] = GpuFluidCountersOutput[index];

    const uint slotPart = GPU_FLUID_COUNTER_WORDS;
    const uint listPart = slotPart + capacity * GPU_FLUID_DEBUG_SLOT_WORDS;
    const uint virtualPart = listPart + capacity;

    if (index < capacity)
    {
      GpuFluidGridDebug[slotPart + index * GPU_FLUID_DEBUG_SLOT_WORDS + 0] = GpuFluidBrickCoordsOutput[index];
      [unroll] for (uint i = 0; i < 4; ++i)
        GpuFluidGridDebug[slotPart + index * GPU_FLUID_DEBUG_SLOT_WORDS + 1 + i] = GpuFluidBrickMeta[index * 4 + i];

      const uint active = GpuFluidCountersOutput[GPU_FLUID_COUNTER_ACTIVE];
      GpuFluidGridDebug[listPart + index] = index < active ? GpuFluidActiveListOutput[index] : GPU_FLUID_INVALID_SLOT;
    }

    if (params.z > 0.5 && index < virtualBricks)
    {
      GpuFluidGridDebug[virtualPart + index * 2 + 0] = GpuFluidPageTableOutput[index];
      GpuFluidGridDebug[virtualPart + index * 2 + 1] = asuint(GpuFluidIndirectionOutput[BrickOfLinear(index, grid)].a);
    }
    return;
  }
}
