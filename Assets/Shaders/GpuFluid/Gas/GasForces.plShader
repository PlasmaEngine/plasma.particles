[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/Common/Common.h>
#include <Shaders/GpuFluid/GpuFluidSparse.hlsli>

// Phase Gas/Forces. One 8 cubed group per active brick (indirect).
//
// Scalars, all 10 cubed texels (each texel's change is local, so the apron stays consistent): advected scalars (the
// temporary side) -> the current side, with cooling T_amb + (T - T_amb) e^(-c dt), density and fuel dissipation, an
// edge fade near open faces (extra dissipation growing quadratically over the last voxels before the face), the density
// clamp that keeps the march's majorant true, and a NaN guard.
//
// Velocity, interior faces, in place: buoyancy (alpha (T - T_amb) - beta rho) along the direction against gravity, with T
// and rho averaged onto the face from the two cells it separates (the -side cell comes from the apron), vorticity
// confinement from the curl GasCurl left in Scratch, velocity dissipation, the speed clamp, and no flow through closed
// domain faces on the -side (the +side faces are apron texels, which GasHalo sets). GasSolids runs next.
//
// Both guards count before they sanitise: every interior texel whose scalars, and every cell whose new face velocities,
// came out NaN or infinite adds one to GPU_FLUID_STAT_NAN (GasAdvect passes a NaN on instead of dropping it), and every
// face the speed clamp cut adds one to GPU_FLUID_STAT_SPEED_CLAMPED.
//
// Params: 0 up direction xyz (unit), alpha (m/s^2 per unit temperature)
//         1 beta (m/s^2 per unit density), ambient temperature, cooling (1/s), density dissipation (1/s)
//         2 density clamp, velocity dissipation (1/s), fuel dissipation (1/s), edge fade width (voxels, 0 = off)
//         3 x edge fade rate at the face (1/s), y vorticity confinement epsilon (0: off; Scratch then holds the curl),
//           z confinement rate (1/s), w 1: the closed-box mass correction
// Pass:   y the tick of the frame (the mass correction's words)
//
// Closed-box mass correction (a closed volume with the whole box allocated, GpuFluid.Gas.MassCorrection): neither the
// semi-Lagrangian backtrace nor MacCormack conserves mass, and in a closed box nothing may leave, so the density is
// scaled by the tick's advection's mass before over after (GasAdvect summed both, GPU_FLUID_STAT_MASS_ADVECT). The
// factor is held to [0.98, 1.02] per tick, a gentle global fix that leaves the local distribution to the advection.

Texture3D<float4> GpuFluidScalarIn;         // advected scalars, apron filled
RWTexture3D<float4> GpuFluidScalarOut;      // the current side, all 10 cubed texels
RWTexture3D<float4> GpuFluidVelocityTarget; // the next velocity side, interior faces in place
Texture3D<float4> GpuFluidCurl;             // the curl (GasCurl, apron filled) when vorticity is on
RWByteAddressBuffer GpuFluidStats;

/// The vorticity confinement acceleration on this texel's three -side faces (m/s^2): eps dx k (N x w), with N the unit
/// gradient of |w| and w the curl, both at the face, and k (1/s, Params3.z) the rate that turns Fedkiw's eps dx (N x w)
/// into an acceleration independent of the tick. Every value lies in the stored brick: the face's two cells and their
/// neighbours across the other axes.
float3 Confinement(int3 texel, float epsilon, float dx, float rate)
{
  if (epsilon <= 0.0)
    return float3(0.0, 0.0, 0.0);

  float3 result = float3(0.0, 0.0, 0.0);
  [unroll] for (uint axis = 0; axis < 3; ++axis)
  {
    int3 belowTexel = texel;
    belowTexel[axis] -= 1;
    const float4 here = GpuFluidCurl.Load(int4(texel, 0));
    const float4 below = GpuFluidCurl.Load(int4(belowTexel, 0));

    float3 gradient;
    [unroll] for (uint g = 0; g < 3; ++g)
    {
      if (g == axis)
      {
        gradient[g] = here.w - below.w;
      }
      else
      {
        int3 e = int3(0, 0, 0);
        e[g] = 1;
        gradient[g] = 0.25 * (GpuFluidCurl.Load(int4(texel + e, 0)).w - GpuFluidCurl.Load(int4(texel - e, 0)).w + GpuFluidCurl.Load(int4(belowTexel + e, 0)).w -
                               GpuFluidCurl.Load(int4(belowTexel - e, 0)).w);
      }
    }

    const float length2 = dot(gradient, gradient);
    if (length2 < 1e-12)
      continue;

    const float3 n = gradient * rsqrt(length2);
    const float3 w = 0.5 * (here.xyz + below.xyz);
    result[axis] = cross(n, w)[axis];
  }

  return epsilon * dx * rate * result;
}

groupshared uint gs_uiNaN;
groupshared uint gs_uiSpeedClamped;

// GPU_FLUID_SLABS groups of 128 threads per brick (the slab dispatch arguments); the counters are summed per group.
GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE / GPU_FLUID_SLABS)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES
  const uint slot = GpuFluidGroupSlot(groupId);
  if (slot == GPU_FLUID_INVALID_SLOT)
    return;

  if (groupIndex == 0)
  {
    gs_uiNaN = 0;
    gs_uiSpeedClamped = 0;
  }
  GroupMemoryBarrierWithGroupSync();

  const float4 step = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasStep);
  const float4 p0 = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasParams0);
  const float4 p1 = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasParams1);
  const float4 p2 = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasParams2);
  const float4 p3 = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasParams3);
  const float dt = step.x;
  const float ambientTemperature = p1.y;

  const int3 base = GpuFluidSlotBase(slot);

  // Scalars.
  {
    const float coolingFactor = exp(-p1.z * dt);
    float massFactor = 1.0;
    if (p3.w > 0.5)
    {
      const uint word = GPU_FLUID_STAT_MASS_ADVECT + 4 * GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasPass).y;
      const uint4 sums = GpuFluidStats.Load4(word * 4);
      const float before = float(sums.y) * 4294967296.0 + float(sums.x);
      const float after = float(sums.w) * 4294967296.0 + float(sums.z);
      massFactor = after > 0.0 ? clamp(before / after, 0.98, 1.02) : 1.0;
      if (groupIndex == 0)
        GpuFluidStats.Store(GPU_FLUID_STAT_MASS_CORRECTION * 4, asuint(massFactor));
    }
    const float densityFactor = exp(-p1.w * dt) * massFactor;
    const float fuelFactor = exp(-p2.z * dt);
    const int3 brick = int3(GpuFluidUnpackBrick(GpuFluidBrickCoords[slot]));
    const float3 gridVoxels = float3(GpuFluidGrid() * GPU_FLUID_BRICK_SIZE);
    const float edgeFadeVoxels = p2.w;
    const float edgeFadeRate = p3.x;

    for (uint i = groupId.z * (GPU_FLUID_BRICK_CELLS / GPU_FLUID_SLABS) + groupIndex; i < GPU_FLUID_BRICK_TEXELS; i += GPU_FLUID_BRICK_CELLS)
    {
      const int3 stored = int3(i % GPU_FLUID_BRICK_STORE, (i / GPU_FLUID_BRICK_STORE) % GPU_FLUID_BRICK_STORE, i / (GPU_FLUID_BRICK_STORE * GPU_FLUID_BRICK_STORE));

      float4 s = GpuFluidScalarIn[base + stored];
      if (!GpuFluidIsFinite(s))
      {
        // Counted once, at the interior texel; the apron texels are copies of other bricks' interiors.
        if (all(stored >= GPU_FLUID_BRICK_APRON) && all(stored < GPU_FLUID_BRICK_APRON + GPU_FLUID_BRICK_SIZE))
          InterlockedAdd(gs_uiNaN, 1u);
        s = float4(0.0, 0.0, 0.0, 0.0); // never let it reach the march
      }

      // Edge fade: gas thins out as it nears an open face, so what leaves the box fades away instead of being cut off
      // along the box's straight edge.
      float edgeFactor = 1.0;
      if (edgeFadeVoxels > 0.0)
      {
        const float3 centre = float3(brick * GPU_FLUID_BRICK_SIZE + stored - GPU_FLUID_BRICK_APRON) + 0.5;
        float nearest = 1e6;
        [unroll] for (uint axis = 0; axis < 3; ++axis)
        {
          if (GpuFluidFaceOpen(axis, -1))
            nearest = min(nearest, centre[axis]);
          if (GpuFluidFaceOpen(axis, 1))
            nearest = min(nearest, gridVoxels[axis] - centre[axis]);
        }
        const float inside = 1.0 - saturate(nearest / edgeFadeVoxels);
        edgeFactor = exp(-edgeFadeRate * inside * inside * dt);
      }

      s.r = clamp(s.r * densityFactor * edgeFactor, 0.0, p2.x);
      s.g = saturate(ambientTemperature + (s.g - ambientTemperature) * coolingFactor);
      s.b = max(s.b * fuelFactor * edgeFactor, 0.0);
      s.a = max(s.a, 0.0);
      GpuFluidScalarOut[base + stored] = GpuFluidRoundHalf(s);
    }
  }

  // Velocity on the three -side faces of this thread's cell.
  {
    const int3 local = int3(groupThreadId.xy, groupThreadId.z + groupId.z * (GPU_FLUID_BRICK_SIZE / GPU_FLUID_SLABS));
    const int3 brick = int3(GpuFluidUnpackBrick(GpuFluidBrickCoords[slot]));
    const int3 cell = brick * GPU_FLUID_BRICK_SIZE + local;
    const int3 texel = base + local + GPU_FLUID_BRICK_APRON;

    const float4 here = GpuFluidScalarIn[texel];
    const float4 belowX = GpuFluidScalarIn[texel - int3(1, 0, 0)];
    const float4 belowY = GpuFluidScalarIn[texel - int3(0, 1, 0)];
    const float4 belowZ = GpuFluidScalarIn[texel - int3(0, 0, 1)];

    const float2 faceX = 0.5 * (here.rg + belowX.rg);
    const float2 faceY = 0.5 * (here.rg + belowY.rg);
    const float2 faceZ = 0.5 * (here.rg + belowZ.rg);

    // rg = density, temperature -> acceleration along up.
    const float3 lift = float3(
      p0.w * (faceX.y - ambientTemperature) - p1.x * faceX.x,
      p0.w * (faceY.y - ambientTemperature) - p1.x * faceY.x,
      p0.w * (faceZ.y - ambientTemperature) - p1.x * faceZ.x);

    float4 velocity = GpuFluidVelocityTarget[texel];
    // Confinement only where there is gas (full from density 0.25 on the face): it restores the curls numerical
    // diffusion takes from the smoke, and must not stir up noise in clear air, where nothing would show it.
    const float3 gas = saturate(4.0 * float3(faceX.x, faceY.x, faceZ.x));
    velocity.xyz = (velocity.xyz + dt * (lift * p0.xyz + gas * Confinement(texel, p3.y, step.y, p3.z))) * exp(-p2.y * dt);
    velocity.w = 0.0;

    // Before the clamp, which would turn a NaN into a bound.
    if (!GpuFluidIsFinite(velocity))
    {
      InterlockedAdd(gs_uiNaN, 1u);
      velocity = float4(0.0, 0.0, 0.0, 0.0);
    }

    const uint uiClamped = (abs(velocity.x) > GPU_FLUID_MAX_SPEED ? 1u : 0u) + (abs(velocity.y) > GPU_FLUID_MAX_SPEED ? 1u : 0u) + (abs(velocity.z) > GPU_FLUID_MAX_SPEED ? 1u : 0u);
    if (uiClamped > 0)
      InterlockedAdd(gs_uiSpeedClamped, uiClamped);
    velocity.xyz = clamp(velocity.xyz, -GPU_FLUID_MAX_SPEED, GPU_FLUID_MAX_SPEED);

    [unroll] for (uint axis = 0; axis < 3; ++axis)
    {
      if (cell[axis] == 0 && !GpuFluidFaceOpen(axis, -1))
        velocity[axis] = 0.0; // the wall itself
    }

    GpuFluidVelocityTarget[texel] = GpuFluidRoundHalf(velocity);
  }

  GroupMemoryBarrierWithGroupSync();

  if (groupIndex == 0)
  {
    if (gs_uiNaN > 0)
      GpuFluidStats.InterlockedAdd(GPU_FLUID_STAT_NAN * 4, gs_uiNaN);
    if (gs_uiSpeedClamped > 0)
      GpuFluidStats.InterlockedAdd(GPU_FLUID_STAT_SPEED_CLAMPED * 4, gs_uiSpeedClamped);
  }
}
