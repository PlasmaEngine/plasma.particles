[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/GpuFluid/GpuFluidSparse.hlsli>

// Phase Gas/Pressure, first kernel: the exact MAC divergence of every interior cell,
// (u[i+1] - u[i] + v[j+1] - v[j] + w[k+1] - w[k]) / dx, the +1 faces of the brick's last cells coming from the apron.
// Faces on closed domain walls are zero by then (GasForces, GasHalo). One 8 cubed group per active brick (indirect).
//
// On the frame's last tick the largest and the summed |div| go to the stats, the "before" half of the projection check.

RWTexture3D<float4> GpuFluidVelocityTarget;
RWStructuredBuffer<float> GpuFluidDivergence;
RWByteAddressBuffer GpuFluidStats;

groupshared uint gs_uiMaxDivergence;
groupshared uint gs_uiSumDivergence;

[numthreads(GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  const uint slot = GpuFluidGroupSlot(groupId);
  if (slot == GPU_FLUID_INVALID_SLOT)
    return;

  const bool bLastTick = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasPass).z != 0;
  const float invDx = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasStep).z;

  if (groupIndex == 0)
  {
    gs_uiMaxDivergence = 0;
    gs_uiSumDivergence = 0;
  }
  GroupMemoryBarrierWithGroupSync();

  const int3 texel = GpuFluidTexel(slot, int3(groupThreadId));
  const float3 minus = GpuFluidVelocityTarget[texel].xyz;
  const float plusX = GpuFluidVelocityTarget[texel + int3(1, 0, 0)].x;
  const float plusY = GpuFluidVelocityTarget[texel + int3(0, 1, 0)].y;
  const float plusZ = GpuFluidVelocityTarget[texel + int3(0, 0, 1)].z;

  float divergence = (plusX - minus.x + plusY - minus.y + plusZ - minus.z) * invDx;
  if (isnan(divergence) || isinf(divergence))
    divergence = 0.0;

  GpuFluidDivergence[slot * GPU_FLUID_BRICK_CELLS + groupIndex] = divergence;

  if (bLastTick)
  {
    InterlockedMax(gs_uiMaxDivergence, asuint(abs(divergence)));
    InterlockedAdd(gs_uiSumDivergence, (uint)min(round(abs(divergence) * GPU_FLUID_DIV_SCALE), 1048576.0));
  }

  GroupMemoryBarrierWithGroupSync();

  if (bLastTick && groupIndex == 0)
  {
    GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_DIV_PRE * 4, gs_uiMaxDivergence);
    GpuFluidStats.InterlockedAdd(GPU_FLUID_STAT_DIV_PRE_SUM * 4, gs_uiSumDivergence);
  }
}
