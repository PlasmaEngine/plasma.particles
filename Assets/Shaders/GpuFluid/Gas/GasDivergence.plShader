[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/GpuFluid/GpuFluidDivergence.hlsli>

// Phase Gas/Pressure, after GasMGSetup, for the red-black SOR solver (the multigrid takes the divergence in its first
// fine launches): the exact MAC divergence of every interior cell and its stats (GpuFluidDivergence.hlsli). Faces on
// closed domain walls are zero by then (GasForces, GasHalo), faces of solids move with them (GasSolids). One 8 cubed
// group per active brick (indirect). Pass.z: 1 on the frame's last tick.

RWTexture3D<float4> GpuFluidVelocityTarget; // only read here
RWStructuredBuffer<float> GpuFluidDivergence;
RWByteAddressBuffer GpuFluidStats;
RWStructuredBuffer<uint> GpuFluidFaceCodes; // only read here: solid cells (GasMGSetup) have no divergence to remove

[numthreads(GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  const uint slot = GpuFluidGroupSlot(groupId);
  if (slot == GPU_FLUID_INVALID_SLOT)
    return;

  const bool bLastTick = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasPass).z != 0;
  const float invDx = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasStep).z;
  const uint index = slot * GPU_FLUID_BRICK_CELLS + groupIndex;

  GpuFluidDivergenceBegin(groupIndex);
  GroupMemoryBarrierWithGroupSync();

  const bool bSolid = GpuFluidCodeIsSolid(GpuFluidFaceCodes[index]);
  GpuFluidDivergence[index] = GpuFluidDivergenceOfCell(GpuFluidVelocityTarget, GpuFluidTexel(slot, int3(groupThreadId)), invDx, bSolid, bLastTick);
  GroupMemoryBarrierWithGroupSync();

  GpuFluidDivergenceEnd(GpuFluidStats, groupIndex, bLastTick);
}
