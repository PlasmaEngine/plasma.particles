[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/Common/Common.h>
#include <Shaders/GpuFluid/GpuFluidMG.hlsli>

// Phase Gas/Finalize, once per frame after the last tick. One 8 cubed group per active brick (indirect).
//
// - NaN guard: every texel of the current scalars and velocity (apron included) that is NaN or infinite is zeroed;
//   interior ones are counted. GasForces and GasDivergence count and zero what each tick produces; this one catches
//   what the projection's last kernels could still write.
// - Overflow: a density beyond the fixed-point range (64), a clamped |div| contribution, or a global sum that wraps
//   adds to GPU_FLUID_STAT_OVERFLOW.
// - Per brick: peak density, temperature and face speed, mean density.
// - Brick table: rgb = atlas brick / 255, a = max(mean, floor) when the peak is above the allocation threshold, else 0,
//   so the march skips the brick.
// - Stats: bounds of the bricks with content, mass, density-weighted centroid, maxima, and the largest and summed |div u|
//   after the projection (the "after" half of the projection check), all integer atomics or float maxima as uint.
//   Solid cells (the last tick's face codes) are left out of the divergence; the largest density left in one goes to
//   GPU_FLUID_STAT_SOLID_DENSITY.
// - Requests for the next frame's allocation (design plan section 3, "marking by face flux and proximity"): a cell has
//   content when its density, temperature or fuel is above the allocation threshold. The brick asks for itself
//   (bucket 1) when any cell has content; for a neighbour across a face, edge or corner when content lies within
//   GPU_FLUID_ALLOC_PROXIMITY voxels of the shared boundary (bucket 3), or when the cell's velocity carries it into the
//   neighbour within the lookahead (bucket 2; at most one brick away). The neighbour mask and the alive flag also go to
//   the slot's meta (N1 checks the allocation against them).
//
// - Brick view (Pass.w bit 0, GpuFluid.Debug.Bricks): a copy of the scalars into GpuFluidBrickView (the free Scratch atlas)
//   with the temperature cleared, and the brick's twelve edges drawn in as gas whose temperature says which bucket keeps
//   the brick (source 1.0, content 0.6, flux 0.4, proximity 0.22, idle 0.1); the volume publishes this copy with a
//   blackbody emission, so the march draws the allocation in the same picture as the gas.
//
// Params: 0 x allocation threshold, y brick mean floor, z lookahead (s), w request words per bucket

RWTexture3D<float4> GpuFluidScalarTarget;
RWTexture3D<float4> GpuFluidVelocityTarget;
RWTexture3D<float4> GpuFluidIndirectionOutput;
RWByteAddressBuffer GpuFluidStats;
RWStructuredBuffer<uint> GpuFluidFaceCodes; // only read here
RWByteAddressBuffer GpuFluidRequests;
RWStructuredBuffer<uint> GpuFluidBrickMeta;
RWTexture3D<float4> GpuFluidBrickView;

groupshared uint gs_uiContent;
groupshared uint gs_uiProximityMask;
groupshared uint gs_uiFluxMask;

/// The 27-bit neighbour mask of the offsets allowed per axis (bit i of each axis' 3 bits: offset i - 1), neighbour n =
/// x + 3 y + 9 z. Built as the product of three per-axis masks: x's bits repeat every 3 positions, y's every 9 in runs
/// of 3, z's in runs of 9.
uint NeighbourMask(uint3 allowed)
{
  const uint maskX = allowed.x * 0x1249249u;
  const uint runsY = ((allowed.y & 1u) != 0 ? 0x7u : 0u) | ((allowed.y & 2u) != 0 ? 0x38u : 0u) | ((allowed.y & 4u) != 0 ? 0x1C0u : 0u);
  const uint maskY = runsY * 0x40201u;
  const uint maskZ = ((allowed.z & 1u) != 0 ? 0x1FFu : 0u) | ((allowed.z & 2u) != 0 ? 0x3FE00u : 0u) | ((allowed.z & 4u) != 0 ? 0x7FC0000u : 0u);
  return maskX & maskY & maskZ & ~(1u << GPU_FLUID_NEIGHBOR_SELF);
}

void Request(uint bucket, uint brickLinear, uint words)
{
  uint previous;
  GpuFluidRequests.InterlockedOr((bucket * words + (brickLinear >> 5)) * 4, 1u << (brickLinear & 31u), previous);
}

groupshared uint gs_uiPeakDensity;
groupshared uint gs_uiPeakTemperature;
groupshared uint gs_uiPeakSpeed;
groupshared uint gs_uiDensitySum; // fixed point GPU_FLUID_MEAN_SCALE
groupshared uint gs_uiCentroid[3]; // fixed point GPU_FLUID_MASS_SCALE
groupshared uint gs_uiNaN;
groupshared uint gs_uiMaxDivergence;
groupshared uint gs_uiSumDivergence;
groupshared uint gs_uiOverflow;
groupshared uint gs_uiSolidDensity;

[numthreads(GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE)]
void main(uint3 groupId : SV_GroupID, uint3 groupThreadId : SV_GroupThreadID, uint groupIndex : SV_GroupIndex)
{
  const uint slot = GpuFluidGroupSlot(groupId);
  if (slot == GPU_FLUID_INVALID_SLOT)
    return;

  const float invDx = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasStep).z;
  const float4 rules = GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasParams0);

  if (groupIndex == 0)
  {
    gs_uiPeakDensity = 0;
    gs_uiPeakTemperature = 0;
    gs_uiPeakSpeed = 0;
    gs_uiDensitySum = 0;
    gs_uiCentroid[0] = 0;
    gs_uiCentroid[1] = 0;
    gs_uiCentroid[2] = 0;
    gs_uiNaN = 0;
    gs_uiMaxDivergence = 0;
    gs_uiSumDivergence = 0;
    gs_uiOverflow = 0;
    gs_uiSolidDensity = 0;
    gs_uiContent = 0;
    gs_uiProximityMask = 0;
    gs_uiFluxMask = 0;
  }
  GroupMemoryBarrierWithGroupSync();

  const uint3 brick = GpuFluidUnpackBrick(GpuFluidBrickCoords[slot]);
  const int3 base = GpuFluidSlotBase(slot);

  // NaN guard over all stored texels.
  for (uint i = groupIndex; i < GPU_FLUID_BRICK_TEXELS; i += GPU_FLUID_BRICK_CELLS)
  {
    const int3 stored = int3(i % GPU_FLUID_BRICK_STORE, (i / GPU_FLUID_BRICK_STORE) % GPU_FLUID_BRICK_STORE, i / (GPU_FLUID_BRICK_STORE * GPU_FLUID_BRICK_STORE));
    const bool bInterior = all(stored >= GPU_FLUID_BRICK_APRON) && all(stored < GPU_FLUID_BRICK_APRON + GPU_FLUID_BRICK_SIZE);

    if (!GpuFluidIsFinite(GpuFluidScalarTarget[base + stored]))
    {
      GpuFluidScalarTarget[base + stored] = float4(0.0, 0.0, 0.0, 0.0);
      if (bInterior)
        InterlockedAdd(gs_uiNaN, 1u);
    }

    if (!GpuFluidIsFinite(GpuFluidVelocityTarget[base + stored]))
    {
      GpuFluidVelocityTarget[base + stored] = float4(0.0, 0.0, 0.0, 0.0);
      if (bInterior)
        InterlockedAdd(gs_uiNaN, 1u);
    }

    // The brick view: the gas without its heat, and the brick's edges as gas as hot as its bucket.
    if ((GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasPass).w & 1u) != 0)
    {
      const uint buckets = GpuFluidBrickMeta[slot * 4 + GPU_FLUID_META_BUCKETS];
      const float heat = (buckets & 1u) != 0 ? 1.0 : ((buckets & 2u) != 0 ? 0.6 : ((buckets & 4u) != 0 ? 0.4 : ((buckets & 8u) != 0 ? 0.22 : 0.1)));
      const int3 local = stored - GPU_FLUID_BRICK_APRON;
      const int3 onEdge = int3(local == 0) | int3(local == GPU_FLUID_BRICK_SIZE - 1);
      const bool bEdge = bInterior && (onEdge.x + onEdge.y + onEdge.z) >= 2;
      const float density = GpuFluidScalarTarget[base + stored].r;
      GpuFluidBrickView[base + stored] = bEdge ? float4(max(density, 0.3), heat, 0.0, 0.0) : float4(density, 0.0, 0.0, 0.0);
    }
  }
  GroupMemoryBarrierWithGroupSync();

  // This thread's interior cell.
  {
    const int3 local = int3(groupThreadId);
    const int3 texel = base + local + GPU_FLUID_BRICK_APRON;
    const float4 s = GpuFluidScalarTarget[texel];
    const float3 minus = GpuFluidVelocityTarget[texel].xyz;
    const float plusX = GpuFluidVelocityTarget[texel + int3(1, 0, 0)].x;
    const float plusY = GpuFluidVelocityTarget[texel + int3(0, 1, 0)].y;
    const float plusZ = GpuFluidVelocityTarget[texel + int3(0, 0, 1)].z;

    const float density = max(s.r, 0.0);
    InterlockedMax(gs_uiPeakDensity, asuint(density));
    InterlockedMax(gs_uiPeakTemperature, asuint(max(s.g, 0.0)));
    InterlockedMax(gs_uiPeakSpeed, asuint(max(max(abs(minus.x), abs(minus.y)), abs(minus.z))));
    if (density > 64.0)
      InterlockedAdd(gs_uiOverflow, 1u); // beyond the fixed-point range of the sums below
    InterlockedAdd(gs_uiDensitySum, (uint)round(min(density, 64.0) * GPU_FLUID_MEAN_SCALE));

    // Density-weighted cell centre, as a fraction of the grid, so the sums stay within the mass's range.
    const float3 gridVoxels = float3(GpuFluidGrid() * GPU_FLUID_BRICK_SIZE);
    const float3 position = (float3(brick * GPU_FLUID_BRICK_SIZE + uint3(local)) + 0.5) / gridVoxels;
    [unroll] for (uint axis = 0; axis < 3; ++axis)
      InterlockedAdd(gs_uiCentroid[axis], (uint)round(min(density, 64.0) * position[axis] * GPU_FLUID_MASS_SCALE));

    // Finite here: the guard above zeroed every non-finite face. A solid cell's faces move with the solid.
    const bool bSolid = GpuFluidCodeIsSolid(GpuFluidFaceCodes[slot * GPU_FLUID_BRICK_CELLS + groupIndex]);
    if (bSolid)
      InterlockedMax(gs_uiSolidDensity, asuint(density));
    const float divergence = bSolid ? 0.0 : abs((plusX - minus.x + plusY - minus.y + plusZ - minus.z) * invDx);
    const float scaled = round(divergence * GPU_FLUID_DIV_SCALE);
    if (scaled > 1048576.0)
      InterlockedAdd(gs_uiOverflow, 1u);
    InterlockedMax(gs_uiMaxDivergence, asuint(divergence));
    InterlockedAdd(gs_uiSumDivergence, (uint)min(scaled, 1048576.0));

    // Requests: content near a face (proximity), and where its velocity takes it within the lookahead (flux).
    if (max(max(density, s.g), s.b) > rules.x)
    {
      // Most cells add nothing new to the masks; the unsynchronised reads only skip atomics that would change nothing.
      if (gs_uiContent == 0)
        InterlockedOr(gs_uiContent, 1u);

      const uint3 lo = uint3(local < GPU_FLUID_ALLOC_PROXIMITY);
      const uint3 hi = uint3(local >= GPU_FLUID_BRICK_SIZE - GPU_FLUID_ALLOC_PROXIMITY);
      const uint3 proximity = uint3(2 | lo.x | (hi.x << 2), 2 | lo.y | (hi.y << 2), 2 | lo.z | (hi.z << 2));
      const uint proximityMask = NeighbourMask(proximity);
      if ((proximityMask & ~gs_uiProximityMask) != 0)
        InterlockedOr(gs_uiProximityMask, proximityMask);

      const float3 velocity = 0.5 * (minus + float3(plusX, plusY, plusZ));
      const float3 target = float3(local) + 0.5 + velocity * (rules.z * invDx);
      const int3 reach = GpuFluidIsFinite(float4(target, 0.0)) ? clamp(int3(floor(target / GPU_FLUID_BRICK_SIZE)), -1, 1) : int3(0, 0, 0);
      const uint3 flux = uint3(2u | (1u << uint(reach.x + 1)), 2u | (1u << uint(reach.y + 1)), 2u | (1u << uint(reach.z + 1)));
      const uint fluxMask = NeighbourMask(flux);
      if ((fluxMask & ~gs_uiFluxMask) != 0)
        InterlockedOr(gs_uiFluxMask, fluxMask);
    }
  }
  GroupMemoryBarrierWithGroupSync();

  const bool bContent = gs_uiContent != 0;

  // One thread per neighbour issues the requests: bucket 2 for flux, else 3 for proximity, 1 for the brick itself.
  if (groupIndex < GPU_FLUID_NEIGHBOR_COUNT)
  {
    const uint words = uint(rules.w);
    const int3 grid = int3(GpuFluidGrid());
    const int3 d = int3(groupIndex % 3, (groupIndex / 3) % 3, groupIndex / 9) - 1;
    const int3 other = int3(brick) + d;
    const uint bit = 1u << groupIndex;

    if (all(other >= 0) && all(other < grid))
    {
      const uint otherLinear = GpuFluidBrickLinear(uint3(other), uint3(grid));
      if (groupIndex == GPU_FLUID_NEIGHBOR_SELF)
      {
        if (bContent)
          Request(GPU_FLUID_BUCKET_ALIVE, otherLinear, words);
      }
      else if ((gs_uiFluxMask & bit) != 0)
      {
        Request(GPU_FLUID_BUCKET_FLUX, otherLinear, words);
      }
      else if ((gs_uiProximityMask & bit) != 0)
      {
        Request(GPU_FLUID_BUCKET_PROXIMITY, otherLinear, words);
      }
    }
  }

  if (groupIndex == 1)
  {
    GpuFluidBrickMeta[slot * 4 + GPU_FLUID_META_ALIVE] = bContent ? 1u : 0u;
    GpuFluidBrickMeta[slot * 4 + GPU_FLUID_META_MASK] = gs_uiFluxMask | gs_uiProximityMask;
  }

  if (groupIndex != 0)
    return;

  const float mean = float(gs_uiDensitySum) / (GPU_FLUID_MEAN_SCALE * GPU_FLUID_BRICK_CELLS);

  const float3 atlasBrick = float3(GpuFluidSlotToAtlasBrick(slot, GpuFluidAtlasBricks()));
  GpuFluidIndirectionOutput[brick] = float4(atlasBrick / 255.0, bContent ? max(mean, rules.y) : 0.0);

  GpuFluidStats.InterlockedAdd(GPU_FLUID_STAT_ACTIVE_BRICKS * 4, 1u);

  if (bContent)
  {
    GpuFluidStats.InterlockedAdd(GPU_FLUID_STAT_CONTENT_BRICKS * 4, 1u);
    GpuFluidStats.InterlockedMin(GPU_FLUID_STAT_BOUNDS_MIN * 4 + 0, brick.x);
    GpuFluidStats.InterlockedMin(GPU_FLUID_STAT_BOUNDS_MIN * 4 + 4, brick.y);
    GpuFluidStats.InterlockedMin(GPU_FLUID_STAT_BOUNDS_MIN * 4 + 8, brick.z);
    GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_BOUNDS_MAX * 4 + 0, brick.x);
    GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_BOUNDS_MAX * 4 + 4, brick.y);
    GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_BOUNDS_MAX * 4 + 8, brick.z);
  }

  // The global sums: a wrap counts as an overflow.
  uint overflow = gs_uiOverflow;
  GpuFluidStatAdd(GpuFluidStats, GPU_FLUID_STAT_MASS, (uint)round(float(gs_uiDensitySum) * (GPU_FLUID_MASS_SCALE / GPU_FLUID_MEAN_SCALE)), overflow);
  GpuFluidStatAdd(GpuFluidStats, GPU_FLUID_STAT_CENTROID + 0, gs_uiCentroid[0], overflow);
  GpuFluidStatAdd(GpuFluidStats, GPU_FLUID_STAT_CENTROID + 1, gs_uiCentroid[1], overflow);
  GpuFluidStatAdd(GpuFluidStats, GPU_FLUID_STAT_CENTROID + 2, gs_uiCentroid[2], overflow);
  GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_MAX_DENSITY * 4, gs_uiPeakDensity);
  GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_MAX_TEMPERATURE * 4, gs_uiPeakTemperature);
  GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_MAX_SPEED * 4, gs_uiPeakSpeed);
  GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_DIV_POST * 4, gs_uiMaxDivergence);
  GpuFluidStats.InterlockedMax(GPU_FLUID_STAT_SOLID_DENSITY * 4, gs_uiSolidDensity);
  GpuFluidStatAdd(GpuFluidStats, GPU_FLUID_STAT_DIV_POST_SUM, gs_uiSumDivergence, overflow);
  if (gs_uiNaN > 0)
    GpuFluidStats.InterlockedAdd(GPU_FLUID_STAT_NAN * 4, gs_uiNaN);
  if (overflow > 0)
    GpuFluidStats.InterlockedAdd(GPU_FLUID_STAT_OVERFLOW * 4, overflow);
}
