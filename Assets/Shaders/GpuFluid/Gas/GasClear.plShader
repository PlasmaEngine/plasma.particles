[PLATFORMS]
ALL

[PERMUTATIONS]

[COMPUTESHADER]

#include <Shaders/GpuFluid/GpuFluidFloatMode.hlsli>
#include <Shaders/Common/Common.h>
#include <Shaders/GpuFluid/GpuFluidSparse.hlsli>

// Phase Gas/Alloc: clears every new brick, all 10 cubed texels of every atlas (a reused slot keeps whatever the last
// brick left in it, and Metal does not zero private textures) plus its pressure, divergence, solid flags, face codes and
// multigrid data. Velocity starts at the ambient wind (Params0.xyz, m/s), scalars at 0. One 8 cubed group per brick of
// the new list (the bricks GasAlloc assigned this frame), indirect.

RWTexture3D<float4> GpuFluidVelocity0;
RWTexture3D<float4> GpuFluidVelocity1;
RWTexture3D<float4> GpuFluidVelocity2;
RWTexture3D<float4> GpuFluidScalar0;
RWTexture3D<float4> GpuFluidScalar1;
RWTexture3D<float4> GpuFluidScratch;
RWStructuredBuffer<float> GpuFluidPressure;
RWStructuredBuffer<float> GpuFluidPressure1;
RWStructuredBuffer<float> GpuFluidDivergence;
RWStructuredBuffer<uint> GpuFluidSolidFlags;
RWStructuredBuffer<uint> GpuFluidFaceCodes;
RWStructuredBuffer<float> GpuFluidMGLocal;
RWStructuredBuffer<float4> GpuFluidMGCoeff;

GPU_FLUID_KERNEL_CAPS
[numthreads(GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE, GPU_FLUID_BRICK_SIZE)]
void main(uint3 groupId : SV_GroupID, uint groupIndex : SV_GroupIndex)
{
  GPU_FLUID_KERNEL_MODES
  const uint slot = GpuFluidNewGroupSlot(groupId);
  if (slot == GPU_FLUID_INVALID_SLOT)
    return;

  const int3 base = GpuFluidSlotBase(slot);
  const float4 zero = float4(0.0, 0.0, 0.0, 0.0);
  const float4 wind = float4(GET_PUSH_CONSTANT(plGpuFluidGasConstants, GpuFluidGasParams0).xyz, 0.0);

  for (uint i = groupIndex; i < GPU_FLUID_BRICK_TEXELS; i += GPU_FLUID_BRICK_CELLS)
  {
    const int3 texel = base + int3(i % GPU_FLUID_BRICK_STORE, (i / GPU_FLUID_BRICK_STORE) % GPU_FLUID_BRICK_STORE, i / (GPU_FLUID_BRICK_STORE * GPU_FLUID_BRICK_STORE));
    GpuFluidVelocity0[texel] = wind;
    GpuFluidVelocity1[texel] = wind;
    GpuFluidVelocity2[texel] = wind;
    GpuFluidScalar0[texel] = zero;
    GpuFluidScalar1[texel] = zero;
    GpuFluidScratch[texel] = zero;
  }

  const uint cell = slot * GPU_FLUID_BRICK_CELLS + groupIndex;
  GpuFluidPressure[cell] = 0.0;
  GpuFluidPressure1[cell] = 0.0;
  GpuFluidDivergence[cell] = 0.0;
  GpuFluidFaceCodes[cell] = 0;

  if (groupIndex < GPU_FLUID_SOLID_FLAG_WORDS)
    GpuFluidSolidFlags[slot * GPU_FLUID_SOLID_FLAG_WORDS + groupIndex] = 0;
  if (groupIndex < GPU_FLUID_MG_LOCAL_STRIDE)
    GpuFluidMGLocal[slot * GPU_FLUID_MG_LOCAL_STRIDE + groupIndex] = 0.0;
  if (groupIndex < GPU_FLUID_MG_COEFF_STRIDE)
    GpuFluidMGCoeff[slot * GPU_FLUID_MG_COEFF_STRIDE + groupIndex] = zero;
}
